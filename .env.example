# Copy this file to `.env` (never commit `.env`) and fill in real values before running
# `docker compose up`.

# --- PostgreSQL ---
POSTGRES_DB=ngofund
POSTGRES_USER=ngofund
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# JWT signing
# Generate a real key with: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-string-at-least-32-bytes
JWT_ISSUER=NgoFund
JWT_AUDIENCE=NgoFundClients

# --- pgAdmin (optional; only starts with `docker compose --profile tools up`) ---
PGADMIN_DEFAULT_EMAIL=admin@ngofund.local
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

GOOGLE_FORM_INTAKE_API_KEY=
INTAKE_PORT=8081

NGROK_AUTHTOKEN=

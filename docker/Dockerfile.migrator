# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/NgoFund.Domain/NgoFund.Domain.csproj src/NgoFund.Domain/
COPY src/NgoFund.Contracts/NgoFund.Contracts.csproj src/NgoFund.Contracts/
COPY src/NgoFund.Application/NgoFund.Application.csproj src/NgoFund.Application/
COPY src/NgoFund.Infrastructure/NgoFund.Infrastructure.csproj src/NgoFund.Infrastructure/
COPY src/NgoFund.Migrator/NgoFund.Migrator.csproj src/NgoFund.Migrator/
RUN dotnet restore src/NgoFund.Migrator/NgoFund.Migrator.csproj

COPY src/NgoFund.Domain src/NgoFund.Domain
COPY src/NgoFund.Contracts src/NgoFund.Contracts
COPY src/NgoFund.Application src/NgoFund.Application
COPY src/NgoFund.Infrastructure src/NgoFund.Infrastructure
COPY src/NgoFund.Migrator src/NgoFund.Migrator

RUN dotnet publish src/NgoFund.Migrator/NgoFund.Migrator.csproj -c Release -o /app/publish --no-restore

# Runtime stage. Needs the ASP.NET Core shared framework (not just the base .NET runtime)
# because NgoFund.Infrastructure carries a FrameworkReference to it — ASP.NET Core Identity's
# full IdentityBuilder surface (AddDefaultTokenProviders, etc.) lives there, not in a NuGet
# package, and Migrator uses UserManager to seed the Super Admin user.
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "NgoFund.Migrator.dll"]

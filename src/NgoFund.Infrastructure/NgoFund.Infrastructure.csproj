<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NgoFund.Application\NgoFund.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for the full ASP.NET Core Identity builder surface (AddDefaultTokenProviders,
         SignInManager, etc.) — those live in the shared framework, not in the
         Microsoft.Extensions.Identity.* NuGet packages, which only cover the framework-agnostic
         subset. This project is not Web-hosted itself, so it isn't pulled in implicitly. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="QuestPDF" Version="2026.7.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ActivityNarrator is internal — NgoFund.UnitTests exercises it directly (no DB) instead of
         going through a real SaveChanges. -->
    <InternalsVisibleTo Include="NgoFund.UnitTests" />
  </ItemGroup>

</Project>

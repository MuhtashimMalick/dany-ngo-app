{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ngofund;Username=ngofund;Password=changeme-in-env"
  },
  "Storage": {
    "RootPath": "storage"
  },
  "GoogleFormIntake": {
    "ApiKey": ""
  },
  "Intake": {
    "Port": 8081
  },
  "Jwt": {
    "SigningKey": "dev-only-signing-key-change-me-must-be-at-least-32-bytes-long",
    "Issuer": "NgoFund",
    "Audience": "NgoFundClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}

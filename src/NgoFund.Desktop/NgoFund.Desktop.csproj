<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <ProjectReference Include="..\NgoFund.Contracts\NgoFund.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed so the relative "app.ico" pack URI in MainWindow.xaml resolves at runtime;
         ApplicationIcon above only embeds it as the .exe's file icon, not a WPF resource. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.10" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Required per Microsoft's documented WPF+BlazorWebView setup — the SDK is Sdk.Razor (not
         plain Sdk) so Razor components AND the static-web-assets pipeline (which is what serves
         _framework/blazor.webview.js) both work; this workaround for a known root-namespace bug
         is also documented (see dotnet/maui#5861). -->
    <RootNamespace>NgoFund.Desktop</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>

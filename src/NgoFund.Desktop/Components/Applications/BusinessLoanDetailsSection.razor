@* Business Loan (ROZGAR) category-detail form — self-contained, same load/save pattern as
   HousingDetailsSection (see its doc comment). Used by the manage modal's Details tab as a single
   block; the create-flow wizard splits the same two field groups (BusinessBackgroundFields/
   BusinessProposalFields) across its own "Applicant Background" and "Proposed Business" pages
   instead of reusing this wrapper — see HousingDetailsSection's doc comment for why. *@
@inject ApiClient ApiClient
@inject AuthState AuthState
@inject ToastService Toast

<FormSection Title="Business Loan Details" Description="From the applicant's Business Loan (Rozgar) form.">
    @if (_error is not null)
    {
        <div class="alert alert-error">@_error</div>
    }

    @if (_isLoading)
    {
        <Skeleton Rows="4" Columns="2" />
    }
    else
    {
        <EditForm Model="_form" OnValidSubmit="SaveAsync" id="business-loan-details-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <fieldset disabled="@(!CanEdit)" class="fieldset-reset">
                <BusinessBackgroundFields Model="_form" />
                <BusinessProposalFields Model="_form" RequestedAmount="RequestedAmount" />
            </fieldset>

            @if (CanEdit)
            {
                <button type="submit" class="btn btn-primary" disabled="@_isSaving" style="margin-top: var(--space-2);">@(_isSaving ? "Saving..." : "Save Business Loan Details")</button>
            }
        </EditForm>
    }
</FormSection>

@code {
    [Parameter, EditorRequired] public Guid ApplicationId { get; set; }
    // Nullable (F5) — Google-Form-originated applications other than Business Loan itself state no
    // amount, and this section can in principle be reached for any application whose base
    // RequestedAmount is now optional, so it mirrors ApplicationDto.RequestedAmount's type exactly
    // rather than assuming a value is always present.
    [Parameter] public decimal? RequestedAmount { get; set; }

    private bool _isLoading = true;
    private bool _isSaving;
    private string? _error;
    private BusinessLoanDetailsFormModel _form = new();

    private bool CanEdit => AuthState.HasPermission("applications.edit");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var existing = await ApiClient.GetBusinessLoanDetailsAsync(ApplicationId);
            if (existing is not null)
            {
                _form = new BusinessLoanDetailsFormModel
                {
                    PaperFormNumber = existing.PaperFormNumber,
                    BusinessPhone = existing.BusinessPhone,
                    Education = existing.Education,
                    Skill = existing.Skill,
                    Experience = existing.Experience,
                    OtherIncomeSources = existing.OtherIncomeSources,
                    TotalMonthlyExpenses = existing.TotalMonthlyExpenses,
                    ProposedBusinessDescription = existing.ProposedBusinessDescription,
                    ProposedBusinessLocation = existing.ProposedBusinessLocation,
                    CapitalRequired = existing.CapitalRequired,
                    CapitalAlreadyAvailable = existing.CapitalAlreadyAvailable,
                    HasPriorBusinessExperience = existing.HasPriorBusinessExperience,
                    PriorBusinessDetails = existing.PriorBusinessDetails,
                    EmergencyContactName = existing.EmergencyContactName,
                    EmergencyContactCnic = existing.EmergencyContactCnic,
                    EmergencyContactPhone = existing.EmergencyContactPhone,
                };
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _error = null;
        try
        {
            var result = await ApiClient.UpsertBusinessLoanDetailsAsync(ApplicationId, new UpsertBusinessLoanApplicationDetailsRequest(
                _form.PaperFormNumber, _form.BusinessPhone, _form.Education, _form.Skill, _form.Experience,
                _form.OtherIncomeSources, _form.TotalMonthlyExpenses, _form.ProposedBusinessDescription,
                _form.ProposedBusinessLocation, _form.CapitalRequired, _form.CapitalAlreadyAvailable,
                _form.HasPriorBusinessExperience, _form.PriorBusinessDetails, _form.EmergencyContactName,
                _form.EmergencyContactCnic, _form.EmergencyContactPhone));

            Toast.Success("Business loan details saved");
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
}

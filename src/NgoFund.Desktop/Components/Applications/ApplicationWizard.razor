        await CreateOrUpdateRequestAndAdvanceAsync();
    }

    private async Task ConfirmZakatAndCreateAsync() => await CreateOrUpdateRequestAndAdvanceAsync();

    /// <summary>Page 1's Next handler. Only creates the application the FIRST time this page is
    /// left — revisiting page 1 (Back, then Next again) previously called CreateApplicationAsync
    /// unconditionally, minting a brand-new application (and abandoning whatever was already saved
    /// against the first one) on every round trip. Once <see cref="_application"/> exists, this
    /// just saves the request-page fields onto it, same as every later page's Next does.</summary>
    private async Task CreateOrUpdateRequestAndAdvanceAsync()
    {
        if (_application is null)
        {
            await CreateApplicationAsync();
        }
        else
        {
            await SaveRequestAndAdvanceAsync();
        }
    }

    private async Task SaveRequestAndAdvanceAsync()
    {
        if (_application is null)
        {
            return;
        }

        _isSaving = true;
        _pageError = null;
        try
        {
            // Category is create-time-only (locked in the markup above once _application is not
            // null, same as IntakeChannel) — changing it post-creation would orphan any
            // already-saved category-detail rows, guarantor rows, and document slot keys tagged
            // against the original category (ApplicationDetailsService.EnsureCategoryAsync throws
            // ApplicationCategoryMismatchException for a mismatched category, making those rows
            // permanently unreachable through this wizard). So there's no page-rebuild branch here
            // — just save-and-advance, like every later page's Next.
            _application = await ApiClient.UpdateApplicationAsync(_application.Id, BuildUpdateRequest());
            AdvancePage();
        }
        catch (ApiException ex)
        {
            _pageError = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CreateApplicationAsync()
    {
        if (_selectedApplicant is null || _requestForm.ApplicationCategoryId is null || _requestForm.FundCategoryId is null)
        {
            return;
        }

        _isSaving = true;
        _pageError = null;
        try
        {
            var created = await ApiClient.CreateApplicationAsync(new CreateApplicationRequest(
                _selectedApplicant.Id, _requestForm.ApplicationCategoryId.Value, _requestForm.FundCategoryId.Value,
                _requestForm.RequestedAmount, _requestForm.Priority, _requestForm.ApplicationDate, _requestForm.Purpose,
                null, null, null, null, null, null,
                _requestForm.IntakeChannel, _requestForm.ExternalFormReference, _requestForm.SubmittedAt,
                null, null, SelectedCategory?.TermsVersion));

            _application = created;
            Toast.Success($"Application created · {created.ApplicationNumber}");
            BuildPagesAfterCreate(created);
            await RefreshDocumentStateAsync();
            AdvancePage();
        }
        catch (ApiException ex)
        {
            _pageError = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void BuildPagesAfterCreate(ApplicationDto app)
    {
        var pages = new List<WizardPageKind> { WizardPageKind.ApplicantRequest, WizardPageKind.Household };

        switch (app.ApplicationCategoryCode)
        {
            case "HOUSE_RENT":
                pages.Add(WizardPageKind.HousingDetails);
                pages.Add(WizardPageKind.Documents);
                break;
            case "SHAADI":
                pages.Add(WizardPageKind.MarriageBride);
                pages.Add(WizardPageKind.MarriageGroom);
                pages.Add(WizardPageKind.Documents);
                break;
            case "ROZGAR":
                pages.Add(WizardPageKind.BusinessBackground);
                pages.Add(WizardPageKind.BusinessProposal);
                // Fully data-driven (F3): as many Guarantor pages as the category requires, not
                // clamped to a hardcoded max — the approval gate itself has no such cap either.
                var guarantorCount = Math.Max(app.RequiresGuarantors, 0);
                _guarantorRows = Enumerable.Range(1, guarantorCount)
                    .Select(seq => new GuarantorRowModel { SequenceNumber = seq }).ToList();
                for (var i = 0; i < guarantorCount; i++)
                {
                    pages.Add(WizardPageKind.Guarantor);
                }
                pages.Add(WizardPageKind.Documents);
                break;
        }

        pages.Add(WizardPageKind.Declaration);
        _pages = pages;
    }


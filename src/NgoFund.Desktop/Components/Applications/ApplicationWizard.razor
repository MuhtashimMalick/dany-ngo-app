    }

    private async Task RefreshDocumentStateAsync()
    {
        // Categories without a manifest never render a Documents page or the completeness
        // checklist in this wizard — nothing here would be displayed, so skip both round trips.
        if (_application is null || !CategoryHasManifest)
        {
            return;
        }

        _documents = await SafeCallAsync(() => ApiClient.GetDocumentsForApplicationAsync(_application.Id)) ?? _documents;

        _isCompletenessLoading = true;
        try
        {
            _completeness = await ApiClient.GetApplicationCompletenessAsync(_application.Id);
        }
        catch (ApiException)
        {
            // Non-fatal — Finish just stays gated on whatever completeness state we last had.
        }
        finally
        {
            _isCompletenessLoading = false;
        }
    }

    private static async Task<T?> SafeCallAsync<T>(Func<Task<T>> call) where T : class
    {
        try
        {
            return await call();
        }
        catch (ApiException)
        {
            return null;
        }
    }

    private async Task RequestCloseAsync()
    {
        if (_application is null)
        {
            // Nothing saved server-side yet — safe to close without confirmation.
            await CloseImmediatelyAsync();
            return;
        }

        _showCloseConfirm = true;
    }

    private async Task CloseImmediatelyAsync() => await OnClosed.InvokeAsync();


        _isSaving = true;
        _pageError = null;
        try
        {
            var entries = _guarantorRows.Select(r => new GuarantorEntry(
                r.Id, r.SequenceNumber, r.MembershipNumber, r.FullName, r.FatherName, r.GrandfatherName, r.Surname,
                r.Cnic, r.ResidentialAddress, r.BusinessAddress, r.BusinessNature, r.PhoneHome, r.PhoneOffice,
                r.PhoneMobile, r.DeclarationAcceptedAt)).ToList();

            var saved = await ApiClient.ReplaceGuarantorsAsync(_application.Id, new ReplaceApplicationGuarantorsRequest(entries));
            _guarantorRows = saved.OrderBy(g => g.SequenceNumber).Select(GuarantorRowModel.FromDto).ToList();
            await RefreshDocumentStateAsync();
            AdvancePage();

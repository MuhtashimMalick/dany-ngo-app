        _requestForm.ApplicationCategoryId!.Value, _requestForm.FundCategoryId!.Value,
        _requestForm.RequestedAmount, _application!.ApprovedAmount, _requestForm.Priority, _requestForm.Purpose,
        _householdForm.DeclaredMonthlyIncome, _householdForm.DeclaredHouseholdSize, _householdForm.DeclaredEarningMembers,
        _householdForm.DeclaredResidentialAddress, _householdForm.DeclaredBusinessAddress, _householdForm.DeclaredHouseStatus,
        _requestForm.ExternalFormReference, _requestForm.SubmittedAt,
        _declarationForm.DeclarationAcceptedAt, _declarationForm.TermsAcceptedAt, SelectedCategory?.TermsVersion);


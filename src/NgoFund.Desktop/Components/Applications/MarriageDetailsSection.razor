@* Marriage Assistance (SHAADI) category-detail form — self-contained, same load/save pattern as
   HousingDetailsSection (see its doc comment). Bride and groom are flat fields on this one DTO,
   not searchable Applicant records. Used by the manage modal's Details tab as a single block; the
   create-flow wizard splits the same two field groups (MarriageBrideFields/MarriageGroomFields)
   across its own "Guardian & Bride's Information" and "Groom's Information & Wedding Dates"
   pages instead of reusing this wrapper — see HousingDetailsSection's doc comment for why. *@
@inject ApiClient ApiClient
@inject ToastService Toast

<FormSection Title="Marriage Assistance Details" Description="From the applicant's Marriage Assistance form.">
    @if (_error is not null)
    {
        <div class="alert alert-error">@_error</div>
    }

    @if (_isLoading)
    {
        <Skeleton Rows="4" Columns="2" />
    }
    else
    {
        <EditForm Model="_form" OnValidSubmit="SaveAsync" id="marriage-details-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <MarriageBrideFields Model="_form" />
            <MarriageGroomFields Model="_form" />

            <button type="submit" class="btn btn-primary" disabled="@_isSaving" style="margin-top: var(--space-2);">@(_isSaving ? "Saving..." : "Save Marriage Details")</button>
        </EditForm>
    }
</FormSection>

@code {
    [Parameter, EditorRequired] public Guid ApplicationId { get; set; }

    private bool _isLoading = true;
    private bool _isSaving;
    private string? _error;
    private MarriageDetailsFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var existing = await ApiClient.GetMarriageDetailsAsync(ApplicationId);
            if (existing is not null)
            {
                _form = new MarriageDetailsFormModel
                {
                    GuardianRelationshipToBride = existing.GuardianRelationshipToBride,
                    BrideName = existing.BrideName,
                    BrideFatherName = existing.BrideFatherName,
                    BrideFamilyName = existing.BrideFamilyName,
                    BrideCnic = existing.BrideCnic,
                    BrideMaritalStatus = existing.BrideMaritalStatus,
                    BridePreviousHusbandName = existing.BridePreviousHusbandName,
                    BrideJamaat = existing.BrideJamaat,
                    BridePriorTrustAssistance = existing.BridePriorTrustAssistance,
                    GroomName = existing.GroomName,
                    GroomFatherName = existing.GroomFatherName,
                    GroomGrandfatherName = existing.GroomGrandfatherName,
                    GroomJamaat = existing.GroomJamaat,
                    GroomMaritalStatus = existing.GroomMaritalStatus,
                    GroomPreviousWifeName = existing.GroomPreviousWifeName,
                    GroomAddress = existing.GroomAddress,
                    GroomMobile = existing.GroomMobile,
                    GroomBusinessAddress = existing.GroomBusinessAddress,
                    NikahDate = existing.NikahDate,
                    RukhsatiDate = existing.RukhsatiDate,
                };
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _error = null;
        try
        {
            await ApiClient.UpsertMarriageDetailsAsync(ApplicationId, new UpsertMarriageApplicationDetailsRequest(
                _form.GuardianRelationshipToBride, _form.BrideName, _form.BrideFatherName, _form.BrideFamilyName,
                _form.BrideCnic, _form.BrideMaritalStatus, _form.BridePreviousHusbandName, _form.BrideJamaat,
                _form.BridePriorTrustAssistance, _form.GroomName, _form.GroomFatherName, _form.GroomGrandfatherName,
                _form.GroomJamaat, _form.GroomMaritalStatus, _form.GroomPreviousWifeName, _form.GroomAddress,
                _form.GroomMobile, _form.GroomBusinessAddress, _form.NikahDate, _form.RukhsatiDate));
            Toast.Success("Marriage details saved");
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
}

@* Mounted once in MainLayout. Renders whatever ToastService.Items currently holds; pages never
   touch the DOM directly, they just call ToastService.Success(...)/Error(...) after a
   create/update/void/status-change action completes. The inline `.alert` block on each page stays
   reserved for form-level validation/API failures — this is purely the fire-and-forget
   confirmation layer. *@
@implements IDisposable
@inject ToastService ToastService
@inject IJSRuntime JS

<div class="toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in ToastService.Items)
    {
        <div class="toast toast-@(KindCssKey(toast.Kind)) @(toast.OnClick is not null ? "toast-clickable" : "")"
             id="@ElementId(toast.Id)" role="@(toast.OnClick is not null ? "button" : "status")"
             tabindex="@(toast.OnClick is not null ? "0" : null)"
             @onclick="() => HandleToastClick(toast)" @onkeydown="e => HandleToastKeyDown(e, toast)">
            <Icon Name="@(IconFor(toast.Kind))" Size="18" CssClass="toast-icon" />
            <span class="toast-text">@toast.Text</span>
            <button type="button" class="toast-dismiss" aria-label="Dismiss notification" @onclick="() => ToastService.Dismiss(toast.Id)" @onclick:stopPropagation="true">
                <Icon Name="close" Size="14" />
            </button>
        </div>
    }
</div>

@code {
    private readonly HashSet<Guid> _animated = [];

    protected override void OnInitialized() => ToastService.Changed += OnChanged;

    private async void OnChanged()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // Component/circuit is already gone — nothing to update.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        foreach (var toast in ToastService.Items)
        {
            if (_animated.Add(toast.Id))
            {
                await JS.InvokeVoidAsync("ngoFundToast.enter", $"#{ElementId(toast.Id)}");
            }
        }
    }

    private static string ElementId(Guid id) => $"toast-{id:N}";

    // F3: the intake poller's Info toast is optionally clickable (navigates to the pre-filtered
    // Applications list) — Success/Error toasts never set ToastMessage.OnClick, so these are no-ops
    // for every other toast in the app.
    private void HandleToastClick(ToastMessage toast)
    {
        if (toast.OnClick is null)
        {
            return;
        }

        toast.OnClick();
        ToastService.Dismiss(toast.Id);
    }

    private void HandleToastKeyDown(KeyboardEventArgs e, ToastMessage toast)
    {
        if (toast.OnClick is not null && e.Key is "Enter" or " ")
        {
            HandleToastClick(toast);
        }
    }

    private static string KindCssKey(ToastKind kind) => kind switch
    {
        ToastKind.Success => "success",
        ToastKind.Info => "info",
        _ => "error",
    };

    private static string IconFor(ToastKind kind) => kind switch
    {
        ToastKind.Success => "check-circle",
        ToastKind.Info => "info",
        _ => "alert-circle",
    };

    public void Dispose() => ToastService.Changed -= OnChanged;
}

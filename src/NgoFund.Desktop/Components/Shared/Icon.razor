@* Small inline-SVG icon set — no icon-font/npm dependency, just hand-authored strokes built from
   basic primitives (circle/rect/ellipse/line/arc) so nothing depends on memorized bezier path
   data. Add a new case here when a screen needs an icon that doesn't exist yet. *@
<svg xmlns="http://www.w3.org/2000/svg" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="@StrokeWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     stroke-linecap="round" stroke-linejoin="round" class="@CssClass" aria-hidden="true">
    @GetMarkup()
</svg>


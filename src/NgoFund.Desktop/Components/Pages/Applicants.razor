@page "/applicants"
@inject ApiClient ApiClient
@inject AuthState AuthState
@inject ToastService Toast
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="page-header">
    @if (AuthState.HasPermission("applicants.create"))
    {
        <SectionContent SectionName="page-actions">
            <button class="btn btn-primary" @onclick="OpenCreateModal">New Applicant</button>
        </SectionContent>
    }
</div>

<FilterBar>
    <SearchBox @bind-Value="_search" OnSearch="() => LoadPageAsync(1)" Placeholder="Search by name, CNIC, membership no…" />
</FilterBar>

@if (_errorMessage is not null)
{
    <div class="alert alert-error">@_errorMessage</div>
}

<DataTable TItem="ApplicantDto" Items="_page?.Items ?? []" IsLoading="_page is null" ShowPagination="true"
           Page="_currentPage" PageSize="PageSize" TotalCount="_page?.TotalCount ?? 0"
           OnPageChange="LoadPageAsync" RowsContainerId="applicants-rows" EmptyText="No applicants found."
           EmptyDescription="Applicants you register will appear here." EmptyIcon="applicants">
    <HeaderRow>
        <th>Membership #</th>
        <th>Name</th>
        <th>CNIC</th>
        <th>Phone</th>
        <th>City</th>
        <th>Status</th>
        <th></th>
    </HeaderRow>
    <RowTemplate Context="applicant">
        <tr>
            <td>@applicant.MembershipNumber</td>
            <td>@applicant.FullName</td>
            <td>@applicant.Cnic</td>
            <td>@applicant.Phone</td>
            <td>@applicant.City</td>
            <td><StatusBadge Status="@(applicant.IsBlacklisted ? "Rejected" : "Active")" Text="@(applicant.IsBlacklisted ? "Blacklisted" : "Active")" /></td>
            <td class="table-actions">
                <button class="icon-btn" aria-label="View applicant" @onclick="() => OpenDetailModalAsync(applicant)"><Icon Name="eye" Size="16" /></button>
                @if (AuthState.HasPermission("applicants.edit"))
                {
                    <button class="icon-btn" aria-label="Edit applicant" @onclick="() => OpenEditModal(applicant)"><Icon Name="pencil" Size="16" /></button>
                }
                @if (AuthState.HasPermission("applicants.delete") && !applicant.IsBlacklisted)
                {
                    <OverflowMenu>
                        <button type="button" class="overflow-menu-item destructive" @onclick="() => RequestBlacklist(applicant)">
                            <Icon Name="trash" Size="15" />Blacklist
                        </button>
                    </OverflowMenu>
                }
            </td>
        </tr>
    </RowTemplate>
</DataTable>

@if (_showForm)
{
    <Modal Title="@(_editingId is null ? "New Applicant" : "Edit Applicant")" Size="lg" OnClose="CloseForm">
        <ChildContent>
        @if (_formError is not null)
        {
            <div class="alert alert-error">@_formError</div>
        }

        <div class="applicant-form-layout">
            <div class="applicant-form-photo">
                <div class="form-section-legend">Photo</div>
                <hr class="form-section-divider" />
                @if (_photoDocumentId is not null)
                {
                    <DocumentThumbnail DocumentId="_photoDocumentId.Value" Style="@PhotoSlotStyle" />
                    <button type="button" class="btn btn-secondary btn-sm btn-block" @onclick="() => _photoDocumentId = null">Retake Photo</button>
                }
                else if (_pendingPhotoDataUrl is not null)
                {
                    <img class="webcam-preview" src="@_pendingPhotoDataUrl" alt="Captured photo" />
                    <button type="button" class="btn btn-secondary btn-sm btn-block" @onclick="ClearPendingPhoto">Replace Photo</button>
                }
                else
                {
                    <div class="applicant-photo-capture">
                        <WebcamCapture OnCaptured="OnPhotoCapturedAsync" />
                        <FileDrop OnFileSelected="OnPhotoFileSelectedAsync" Accept=".jpg,.jpeg,.png,.webp"
                                  MaxSizeBytes="InlineFileUpload.MaxSizeBytes" Hint="JPG, PNG or WEBP up to 10 MB" />
                    </div>
                }
            </div>

            <div class="applicant-form-fields">
                <EditForm Model="_form" OnValidSubmit="SaveAsync" id="applicant-form">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="validation-summary" />

                    <FormSection Title="Identity">
                        <div class="form-grid">
                            <FormField Label="Full Name" For="fullName" ValidationFor="() => _form.FullName">
                                <InputText id="fullName" @bind-Value="_form.FullName" />
                            </FormField>

                            <FormField Label="Surname" For="surname">
                                <InputText id="surname" @bind-Value="_form.Surname" maxlength="100" />
                            </FormField>

                            <FormField Label="Father / Husband Name" For="fatherOrHusbandName">
                                <InputText id="fatherOrHusbandName" @bind-Value="_form.FatherOrHusbandName" />
                            </FormField>

                            <FormatField Label="CNIC" For="cnic" Format="FieldFormat.Cnic" @bind-Value="_form.Cnic" />

                            <FormField Label="@(_editingId is null ? "Gender *" : "Gender")" For="gender"
                                       Hint="@(_editingId is not null && string.IsNullOrEmpty(_form.Gender) ? "Arrived without a gender (e.g. a Google Form submission) — select one to fill it in." : null)">
                                <InputSelect id="gender" @bind-Value="_form.Gender">
                                    <option value="">Select...</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </InputSelect>
                            </FormField>

                            <FormField Label="Membership Number" For="membershipNumber">
                                <InputText id="membershipNumber" @bind-Value="_form.MembershipNumber" maxlength="@PakistaniFormats.JamaatMembershipMaxLength" />
                            </FormField>
                        </div>
                    </FormSection>

                    <FormSection Title="Contact">
                        <div class="form-grid">
                            <FormatField Label="Phone" For="phone" Format="FieldFormat.MobilePhone" @bind-Value="_form.Phone" />

                            <FormField Label="Email" For="email">
                                <InputText id="email" @bind-Value="_form.Email" />
                            </FormField>

                            <FormField Label="Address" For="address" CssClass="span-2">
                                <InputText id="address" @bind-Value="_form.Address" />
                            </FormField>

                            <FormField Label="City" For="city">
                                <InputText id="city" @bind-Value="_form.City" />
                            </FormField>
                        </div>
                    </FormSection>

                    <FormSection Title="Livelihood">
                        <div class="form-grid">
                            <FormField Label="Occupation" For="occupation">
                                <InputText id="occupation" @bind-Value="_form.Occupation" />
                            </FormField>

                            <FormField Label="Monthly Income" For="monthlyIncome">
                                <InputNumber id="monthlyIncome" @bind-Value="_form.MonthlyIncome" />
                            </FormField>
                        </div>
                    </FormSection>

                    <FormSection Title="Identity Documents"
                                 Description="@(_editingId is null ? "Required to register a new applicant — applicants added before this rule are unaffected." : "Choosing a file replaces the document on file immediately.")">
                        @if (_editingId is null)
                        {
                            <ApplicantDocumentSlot Mode="ApplicantDocumentMode.Create" DocumentType="@ApplicantDocumentCategories.CnicFront.DocumentType" Label="@ApplicantDocumentCategories.CnicFront.Label"
                                                    PendingFileName="@_cnicFrontUpload?.FileName"
                                                    OnFileSelected="OnCnicFrontSelectedAsync"
                                                    OnFileRemoved="() => _cnicFrontUpload = null" />

                            <ApplicantDocumentSlot Mode="ApplicantDocumentMode.Create" DocumentType="@ApplicantDocumentCategories.CnicBack.DocumentType" Label="@ApplicantDocumentCategories.CnicBack.Label"
                                                    PendingFileName="@_cnicBackUpload?.FileName"
                                                    OnFileSelected="OnCnicBackSelectedAsync"
                                                    OnFileRemoved="() => _cnicBackUpload = null" />

                            <ApplicantDocumentSlot Mode="ApplicantDocumentMode.Create" DocumentType="@ApplicantDocumentCategories.MembershipCard.DocumentType" Label="@ApplicantDocumentCategories.MembershipCard.Label"
                                                    PendingFileName="@_membershipCardUpload?.FileName"
                                                    OnFileSelected="OnMembershipCardSelectedAsync"
                                                    OnFileRemoved="() => _membershipCardUpload = null" />
                        }
                        else if (_isLoadingEditDocuments)
                        {
                            <Skeleton Rows="3" Columns="1" />
                        }
                        else
                        {
                            <ApplicantDocumentSlots Documents="_editDocuments" PhotoDocumentId="_photoDocumentId" Mode="ApplicantDocumentMode.Edit"
                                                     BusyDocumentType="_editDocumentBusyType" SlotErrors="_editDocumentErrors"
                                                     OnViewDocument="document => _viewingDocument = document"
                                                     OnReplace="HandleEditDocumentReplaceAsync" />
                        }
                    </FormSection>

                    @if (_editingId is not null)
                    {
                        <FormSection Title="Status">
                            <label class="checkbox-label mb-3">
                                <input type="checkbox" @bind="_form.IsBlacklisted" />
                                Blacklisted
                            </label>

                            @if (_form.IsBlacklisted)
                            {
                                <div class="form-grid">
                                    <FormField Label="Blacklist Reason" For="blacklistReason" CssClass="span-2">
                                        <InputText id="blacklistReason" @bind-Value="_form.BlacklistReason" />
                                    </FormField>
                                </div>
                            }
                        </FormSection>
                    }
                </EditForm>
            </div>
        </div>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseForm">Cancel</button>
            <button type="submit" form="applicant-form" class="btn btn-primary" disabled="@_isSaving">@(_isSaving ? "Saving..." : "Save")</button>
        </Footer>
    </Modal>
}

@if (_viewingApplicant is not null)
{
    <Modal Title="@_viewingApplicant.FullName" Size="lg" OnClose="CloseDetailModal">
        <ChildContent>
        @if (_detailError is not null)
        {
            <div class="alert alert-error">@_detailError</div>
        }

        <div class="flex gap-4 flex-wrap">
            @if (_viewingApplicant.PhotoDocumentId is not null)
            {
                <button type="button" class="applicant-photo-tile" @ref="_photoTileRef"
                        aria-label="@($"View full-size photo of {_viewingApplicant.FullName}")"
                        @onclick="() => _showPhotoLightbox = true"
                        @onmouseenter="() => AnimatePhotoTileHoverAsync(true)"
                        @onmouseleave="() => AnimatePhotoTileHoverAsync(false)"
                        @onfocus="() => AnimatePhotoTileHoverAsync(true)"
                        @onblur="() => AnimatePhotoTileHoverAsync(false)">
                    <DocumentThumbnail DocumentId="_viewingApplicant.PhotoDocumentId.Value" Style="width:100%;height:100%;object-fit:cover;display:block;" />
                    <span class="applicant-photo-tile-overlay" @ref="_photoTileOverlayRef">
                        <Icon Name="maximize" Size="16" />
                        <span>View</span>
                    </span>
                </button>
            }
            else
            {
                <div class="applicant-photo-tile applicant-photo-tile-empty" aria-hidden="true">
                    <Icon Name="applicants" Size="22" />
                </div>
            }
            <div class="flex-1">
                <DetailList>
                    <DetailItem Label="Membership #" Value="@(_viewingApplicant.MembershipNumber ?? "-")" />
                    <DetailItem Label="CNIC" Value="@_viewingApplicant.Cnic" />
                    <DetailItem Label="Father/Husband" Value="@(_viewingApplicant.FatherOrHusbandName ?? "-")" />
                    <DetailItem Label="Surname" Value="@(_viewingApplicant.Surname ?? "-")" />
                    <DetailItem Label="Gender" Value="@(_viewingApplicant.Gender ?? "Not stated")" />
                    <DetailItem Label="Phone" Value="@(_viewingApplicant.Phone ?? "-")" />
                    <DetailItem Label="Email" Value="@(_viewingApplicant.Email ?? "-")" />
                    <DetailItem Label="Address" Value="@(_viewingApplicant.Address ?? "-")" SpanFull="true" />
                    <DetailItem Label="City" Value="@(_viewingApplicant.City ?? "-")" />
                    <DetailItem Label="Occupation" Value="@(_viewingApplicant.Occupation ?? "-")" />
                    <DetailItem Label="Monthly Income" Value="@(_viewingApplicant.MonthlyIncome?.ToString("N2") ?? "-")" IsNumeric="true" />
                    <DetailItem Label="Status">
                        <StatusBadge Status="@(_viewingApplicant.IsBlacklisted ? "Rejected" : "Active")" Text="@(_viewingApplicant.IsBlacklisted ? "Blacklisted" : "Active")" />
                    </DetailItem>
                </DetailList>
            </div>
        </div>

        <h4>Documents</h4>
        @if (_isLoadingDocuments)
        {
            <Skeleton Rows="2" Columns="1" />
        }
        else
        {
            <div id="applicant-documents-rows">
                <ApplicantDocumentSlots Documents="_applicantDocuments" PhotoDocumentId="_viewingApplicant.PhotoDocumentId" Mode="ApplicantDocumentMode.View"
                                         OnViewDocument="document => _viewingDocument = document" />
            </div>
        }

        <h4>Application History</h4>
        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>App #</th>
                        <th>Category</th>
                        <th>Fund</th>
                        <th class="num">Requested (PKR)</th>
                        <th class="num">Approved (PKR)</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_applicantApplications.Count == 0)
                    {
                        <tr><td colspan="7">No applications yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var application in _applicantApplications)
                        {
                            <tr>
                                <td>@application.ApplicationNumber</td>
                                <td>@application.ApplicationCategoryName</td>
                                <td>@application.FundCategoryName</td>
                                <td class="num">@(application.RequestedAmount?.ToString("N2") ?? "Not stated")</td>
                                <td class="num">@(application.ApprovedAmount?.ToString("N2") ?? "-")</td>
                                <td><StatusBadge Status="@application.Status" /></td>
                                <td>@application.ApplicationDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (AuthState.HasPermission("payments.view") && AuthState.HasPermission("loans.view"))
        {
            <div class="flex justify-between items-center">
                <p class="field-hint mb-0">See every payment and loan repayment for this applicant, across all funds.</p>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ViewLedger">
                    <Icon Name="eye" Size="15" />View Fund Ledger
                </button>
            </div>
        }
        else
        {
            <p class="field-hint">To record a payment or review status/remarks/documents for one of these, find it by application # or CNIC on the Applications page.</p>
        }
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseDetailModal">Close</button>
            @if (AuthState.HasPermission("applicants.edit"))
            {
                <button type="button" class="btn btn-primary" @onclick="OpenEditFromDetailAsync">
                    <Icon Name="pencil" Size="15" />Edit
                </button>
            }
        </Footer>
    </Modal>
}

<DocumentViewer Document="_viewingDocument" OnClose="() => _viewingDocument = null" />

@if (_showPhotoLightbox && _viewingApplicant?.PhotoDocumentId is not null)
{
    <Modal Title="@($"Photo — {_viewingApplicant.FullName}")" Size="sm" OnClose="() => _showPhotoLightbox = false">
        <ChildContent>
        <div class="applicant-photo-lightbox">
            <DocumentThumbnail DocumentId="_viewingApplicant.PhotoDocumentId.Value" Style="max-width:100%;max-height:70vh;object-fit:contain;border-radius:var(--radius-md);display:block;" />
        </div>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="() => _showPhotoLightbox = false">Close</button>
        </Footer>
    </Modal>
}

<ConfirmDialog @bind-IsOpen="_confirmOpen" Title="Blacklist applicant?"
               Message="@($"Blacklist {_applicantPendingBlacklist?.FullName}? They will no longer be eligible for new applications.")"
               ConfirmText="Blacklist" IsDestructive="true" OnConfirmed="BlacklistConfirmedAsync" />

@code {
    // Deep-link from a document slot that's Applicant-scoped but not yet satisfied (see
    // DocumentSlotRow's OwnerScope == "Applicant" branch) — staff are sent here with
    // ?applicantId={id} instead of being offered an upload control on the application, since the
    // document belongs on the applicant's own record. Mirrors Applications.razor's
    // ?applicationId deep-link from the Dashboard.
    [SupplyParameterFromQuery(Name = "applicantId")]
    [Parameter]
    public Guid? ApplicantIdQuery { get; set; }

    private Guid? _autoOpenedApplicantId;

    private const int PageSize = 25;
    private PagedResult<ApplicantDto>? _page;
    private int _currentPage = 1;
    private string _search = "";
    private string? _errorMessage;
    private bool _pendingRowAnimation;

    private bool _showForm;
    private bool _isSaving;
    private string? _formError;
    private Guid? _editingId;
    private ApplicantDto? _editingApplicant;
    private Guid? _photoDocumentId;
    private byte[]? _pendingPhotoBytes;
    private string? _pendingPhotoDataUrl;
    private string _pendingPhotoFileName = "photo.jpg";
    private string _pendingPhotoContentType = "image/jpeg";
    private ApplicantFormModel _form = new();

    // Create-only required-document uploads (Task 4b) — held client-side as raw bytes because the
    // applicant row (their owner) doesn't exist yet; sent inline on CreateApplicantRequest and
    // committed in the same DB transaction as the applicant. Not used on edit — see the Identity
    // Documents FormSection's `_editingId is null` branch, which renders ApplicantDocumentSlots
    // (Edit mode, immediate upload) instead once an applicant row actually exists.
    private PendingUpload? _cnicFrontUpload;
    private PendingUpload? _cnicBackUpload;
    private PendingUpload? _membershipCardUpload;

    private record PendingUpload(string FileName, string ContentType, byte[] Bytes);

    private bool _confirmOpen;
    private ApplicantDto? _applicantPendingBlacklist;

    private ApplicantDto? _viewingApplicant;
    private IReadOnlyList<ApplicationDto> _applicantApplications = [];
    private string? _detailError;
    private bool _showPhotoLightbox;
    private ElementReference _photoTileRef;
    private ElementReference _photoTileOverlayRef;

    // Task 4: the applicant's own documents (CNIC front/back, membership card, etc.) — fetched
    // alongside their application history when the detail modal opens, not eagerly on page load.
    // The profile photo is excluded by exact DocumentId comparison (never string-matched on
    // DocumentType) since it's already shown separately via the photo tile + lightbox above.
    private IReadOnlyList<DocumentDto> _applicantDocuments = [];
    private bool _isLoadingDocuments;
    private bool _pendingDocumentsAnimation;
    private DocumentDto? _viewingDocument;

    // Edit-modal document state (F6/Issue 1 fix) — loaded fresh by OpenEditModal every time it
    // opens (not shared with _applicantDocuments above, which belongs to the read-only detail
    // modal) so a replace's effect is always reflected without reaching into the detail modal's
    // own state. Keyed by ApplicantProfileDocumentTypes value.
    private IReadOnlyList<DocumentDto> _editDocuments = [];
    private bool _isLoadingEditDocuments;
    private string? _editDocumentBusyType;
    private readonly Dictionary<string, string> _editDocumentErrors = new();

    // Same box recipe as .webcam-frame/.webcam-preview in app.css (100% width, 4:3 aspect ratio,
    // radius-md, 1px border) so a saved photo doesn't visibly jump size/shape relative to the
    // "just captured" and "live camera" states in the same column — DocumentThumbnail's own
    // default (max-width/max-height 160px) is intentionally overridden here per-usage.
    private const string PhotoSlotStyle =
        "display:block; width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--radius-md); border:1px solid var(--color-border);";

    // The "view full photo" tile's hover/focus overlay fade + slight scale is a real GSAP tween
    // (not a CSS :hover transition) per this app's motion convention — see
    // ngoFundMotion.animatePhotoTileHover in interop.js, which is itself wrapped in
    // gsap.matchMedia() for prefers-reduced-motion.
    private async Task AnimatePhotoTileHoverAsync(bool isEntering)
    {
        try
        {
            await JS.InvokeVoidAsync("ngoFundMotion.animatePhotoTileHover", _photoTileOverlayRef, _photoTileRef, isEntering);
        }
        catch (JSDisconnectedException)
        {
            // Circuit tearing down (e.g. navigating away) — nothing left to animate.
        }
    }

    private void ViewLedger()
    {
        if (_viewingApplicant is not null)
        {
            Navigation.NavigateTo($"/applicants/{_viewingApplicant.Id}/ledger");
        }
    }

    private async Task OpenDetailModalAsync(ApplicantDto applicant)
    {
        _viewingApplicant = applicant;
        _detailError = null;
        _applicantApplications = [];
        _applicantDocuments = [];
        _showPhotoLightbox = false;

        _isLoadingDocuments = true;
        try
        {
            var applicationsTask = ApiClient.GetApplicationsAsync(1, 100, applicantId: applicant.Id);
            var documentsTask = ApiClient.GetDocumentsForApplicantAsync(applicant.Id);
            await Task.WhenAll(applicationsTask, documentsTask);

            _applicantApplications = applicationsTask.Result.Items;
            _applicantDocuments = documentsTask.Result;
            _pendingDocumentsAnimation = true;
        }
        catch (ApiException ex)
        {
            _detailError = ex.Message;
        }
        finally
        {
            _isLoadingDocuments = false;
        }
    }

    protected override async Task OnInitializedAsync() => await LoadPageAsync(1);

    protected override async Task OnParametersSetAsync()
    {
        if (ApplicantIdQuery is { } id && id != _autoOpenedApplicantId)
        {
            _autoOpenedApplicantId = id;
            try
            {
                var applicant = await ApiClient.GetApplicantAsync(id);
                await OpenDetailModalAsync(applicant);
            }
            catch (ApiException)
            {
                // Stale/invalid id in the URL — nothing to open, fall through to the plain list.
            }
        }
    }

    private void CloseDetailModal()
    {
        _viewingApplicant = null;
        _viewingDocument = null;

        // Drop the query-string id so navigating away and back doesn't try to re-open a modal
        // that's already been closed — same convention as Applications.razor's CloseManageModal.
        if (ApplicantIdQuery is not null)
        {
            Navigation.NavigateTo("/applicants", replace: true);
        }
    }

    // Closes the read-only dead end DocumentSlotRow used to send staff into (view modal, no upload
    // affordance) by reusing the same deep-link they already land on — jumps straight to Edit for
    // the applicant currently open in the detail modal.
    private async Task OpenEditFromDetailAsync()
    {
        if (_viewingApplicant is not { } applicant)
        {
            return;
        }

        CloseDetailModal();
        await OpenEditModal(applicant);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingRowAnimation)
        {
            _pendingRowAnimation = false;
            await JS.InvokeVoidAsync("ngoFundMotion.animateTableRows", "#applicants-rows tr");
        }
        if (_pendingDocumentsAnimation)
        {
            _pendingDocumentsAnimation = false;
            // Selector updated for the grouped-by-category layout (ApplicantDocumentSlots, Issue 2
            // fix) — each category is now its own .doc-slot-row rather than a flat <li> per
            // document, and every category always renders (even empty ones show "Not on file"), so
            // this no longer needs the old VisibleApplicantDocuments.Count > 0 gate.
            await JS.InvokeVoidAsync("ngoFundMotion.animateChecklistItems", "#applicant-documents-rows .doc-slot-row");
        }
    }

    private async Task LoadPageAsync(int page)
    {
        _errorMessage = null;
        try
        {
            _page = await ApiClient.GetApplicantsAsync(page, PageSize, string.IsNullOrWhiteSpace(_search) ? null : _search);
            _currentPage = page;
            _pendingRowAnimation = true;
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void OpenCreateModal()
    {
        _editingId = null;
        _editingApplicant = null;
        _photoDocumentId = null;
        _pendingPhotoBytes = null;
        _pendingPhotoDataUrl = null;
        _pendingPhotoFileName = "photo.jpg";
        _pendingPhotoContentType = "image/jpeg";
        _cnicFrontUpload = null;
        _cnicBackUpload = null;
        _membershipCardUpload = null;
        _form = new ApplicantFormModel { Gender = "Male" };
        _formError = null;
        _showForm = true;
    }

    private async Task OpenEditModal(ApplicantDto applicant)
    {
        _editingId = applicant.Id;
        _editingApplicant = applicant;
        _photoDocumentId = applicant.PhotoDocumentId;
        _pendingPhotoBytes = null;
        _pendingPhotoDataUrl = null;
        _form = new ApplicantFormModel
        {
            FullName = applicant.FullName,
            Surname = applicant.Surname,
            FatherOrHusbandName = applicant.FatherOrHusbandName,
            Cnic = applicant.Cnic,
            Gender = applicant.Gender,
            MembershipNumber = applicant.MembershipNumber,
            Phone = applicant.Phone,
            Email = applicant.Email,
            Address = applicant.Address,
            City = applicant.City,
            Occupation = applicant.Occupation,
            MonthlyIncome = applicant.MonthlyIncome,
            IsBlacklisted = applicant.IsBlacklisted,
            BlacklistReason = applicant.BlacklistReason,
        };
        _formError = null;
        _editDocuments = [];
        _editDocumentBusyType = null;
        _editDocumentErrors.Clear();
        _showForm = true;

        // Opens the modal immediately (above) so the rest of the form is usable right away, then
        // fills the Identity Documents section once this resolves — FormSection shows a Skeleton
        // for that section in the meantime (see the Identity Documents FormSection markup).
        _isLoadingEditDocuments = true;
        var targetApplicantId = applicant.Id;
        try
        {
            var documents = await ApiClient.GetDocumentsForApplicantAsync(applicant.Id);
            if (targetApplicantId == _editingId)
            {
                _editDocuments = documents;
            }
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _isLoadingEditDocuments = false;
        }
    }

    private void CloseForm()
    {
        _showForm = false;
        _pendingPhotoBytes = null;
        _pendingPhotoDataUrl = null;
    }

    private void ClearPendingPhoto()
    {
        _pendingPhotoBytes = null;
        _pendingPhotoDataUrl = null;
    }

    private async Task OnPhotoCapturedAsync(byte[] bytes)
    {
        if (_editingId is null)
        {
            // No applicant row exists yet, so there is nothing to attach the document to
            // (the API requires exactly one owner id). Hold the bytes client-side and send them
            // inline on CreateApplicantRequest once the applicant is actually created in SaveAsync.
            _pendingPhotoBytes = bytes;
            _pendingPhotoFileName = "photo.jpg";
            _pendingPhotoContentType = "image/jpeg";
            _pendingPhotoDataUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(bytes)}";
            return;
        }

        _pendingPhotoBytes = null;
        _pendingPhotoDataUrl = null;

        try
        {
            var document = await ApiClient.UploadDocumentAsync(bytes, "photo.jpg", "image/jpeg", "ApplicantPhoto",
                applicantId: _editingId);
            _photoDocumentId = document.Id;
            await ApiClient.SetApplicantPhotoAsync(_editingId.Value, document.Id);
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
        }
    }

    // Manual-upload alternative to the webcam (Task 4a) — fills the exact same profile-photo slot
    // (DocumentType.ApplicantPhoto / PhotoDocumentId) as a webcam capture, not a distinct photo
    // kind. Content type is carried from the actual file, never hardcoded to image/jpeg, because
    // the server content-sniffs the bytes and rejects a mismatched label.
    private async Task OnPhotoFileSelectedAsync(IBrowserFile file)
    {
        var bytes = await ReadAllBytesAsync(file);

        if (_editingId is null)
        {
            _pendingPhotoBytes = bytes;
            _pendingPhotoFileName = file.Name;
            _pendingPhotoContentType = file.ContentType;
            _pendingPhotoDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
            return;
        }

        _pendingPhotoBytes = null;
        _pendingPhotoDataUrl = null;

        try
        {
            var document = await ApiClient.UploadDocumentAsync(bytes, file.Name, file.ContentType, "ApplicantPhoto",
                applicantId: _editingId);
            _photoDocumentId = document.Id;
            await ApiClient.SetApplicantPhotoAsync(_editingId.Value, document.Id);
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
        }
    }

    private Task OnCnicFrontSelectedAsync(IBrowserFile file) => ReadPendingUploadAsync(file, u => _cnicFrontUpload = u);
    private Task OnCnicBackSelectedAsync(IBrowserFile file) => ReadPendingUploadAsync(file, u => _cnicBackUpload = u);
    private Task OnMembershipCardSelectedAsync(IBrowserFile file) => ReadPendingUploadAsync(file, u => _membershipCardUpload = u);

    private async Task ReadPendingUploadAsync(IBrowserFile file, Action<PendingUpload> assign) =>
        assign(new PendingUpload(file.Name, file.ContentType, await ReadAllBytesAsync(file)));

    private static async Task<byte[]> ReadAllBytesAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(InlineFileUpload.MaxSizeBytes);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        return memory.ToArray();
    }

    // Edit-modal document replace/add (Issue 1 fix) — fires as soon as a file is picked in
    // ApplicantDocumentSlots' Edit mode; there is no separate save step for documents. A per-slot
    // error is shown inline on that one category only (never _formError), and missing/incomplete
    // documents never block Save here — only the create flow gates on them (see SaveAsync's
    // _editingId is null branch).
    private async Task HandleEditDocumentReplaceAsync((string DocumentType, IBrowserFile File) replace)
    {
        if (_editingId is not { } applicantId)
        {
            return;
        }

        var (documentType, file) = replace;
        var label = ApplicantDocumentCategories.All.First(c => c.DocumentType == documentType).Label;

        _editDocumentErrors.Remove(documentType);
        _editDocumentBusyType = documentType;

        try
        {
            var bytes = await ReadAllBytesAsync(file);
            await ApiClient.ReplaceApplicantDocumentAsync(applicantId, documentType, bytes, file.Name, file.ContentType);
            Toast.Success($"{label} updated · {file.Name}");
            var documents = await ApiClient.GetDocumentsForApplicantAsync(applicantId);
            if (applicantId == _editingId)
            {
                _editDocuments = documents;
            }
        }
        catch (ApiException ex)
        {
            _editDocumentErrors[documentType] = ex.Message;
        }
        finally
        {
            _editDocumentBusyType = null;
        }
    }

    private static InlineFileUpload? ToInlineUpload(PendingUpload? upload) =>
        upload is null ? null : new InlineFileUpload(upload.FileName, upload.ContentType, Convert.ToBase64String(upload.Bytes));

    private async Task SaveAsync()
    {
        _formError = null;

        if (_editingId is null)
        {
            // Staff create still requires Gender even though the shared form model/DTO are now
            // nullable (F5) — the server rejects an empty value here too, this just surfaces it
            // without a round trip.
            if (string.IsNullOrEmpty(_form.Gender))
            {
                _formError = "Select a gender before saving.";
                return;
            }

            // Fast client-side guard ahead of the server's own rejection (400) — named so the
            // user knows exactly which document to add instead of just seeing a disabled button.
            var missingDocs = new List<string>();
            if (_cnicFrontUpload is null)
            {
                missingDocs.Add("CNIC (Front)");
            }
            if (_cnicBackUpload is null)
            {
                missingDocs.Add("CNIC (Back)");
            }
            if (_membershipCardUpload is null)
            {
                missingDocs.Add("Jamaat Membership Card");
            }
            if (missingDocs.Count > 0)
            {
                _formError = $"Upload the required document(s) before saving: {string.Join(", ", missingDocs)}.";
                return;
            }
        }

        _isSaving = true;
        try
        {
            if (_editingId is null)
            {
                var photo = _pendingPhotoBytes is not null
                    ? new InlineFileUpload(_pendingPhotoFileName, _pendingPhotoContentType, Convert.ToBase64String(_pendingPhotoBytes))
                    : null;

                // The server now takes CNIC/membership-card/photo inline and commits the applicant
                // plus its documents in one DB transaction — either everything succeeds or nothing
                // is created, so there is no separate post-create upload step or compensating toast
                // to run here anymore.
                var created = await ApiClient.CreateApplicantAsync(new CreateApplicantRequest(
                    MembershipNumber: _form.MembershipNumber,
                    FullName: _form.FullName,
                    FatherOrHusbandName: _form.FatherOrHusbandName,
                    Cnic: _form.Cnic,
                    Gender: _form.Gender,
                    DateOfBirth: null,
                    MaritalStatus: null,
                    Phone: _form.Phone,
                    AlternatePhone: null,
                    Email: _form.Email,
                    Address: _form.Address,
                    City: _form.City,
                    District: null,
                    Province: null,
                    Occupation: _form.Occupation,
                    MonthlyIncome: _form.MonthlyIncome,
                    DependentsCount: null,
                    HouseholdSize: null,
                    Notes: null,
                    Surname: _form.Surname,
                    CnicFront: ToInlineUpload(_cnicFrontUpload),
                    CnicBack: ToInlineUpload(_cnicBackUpload),
                    MembershipCard: ToInlineUpload(_membershipCardUpload),
                    Photo: photo));

                Toast.Success($"Applicant created · {created.FullName}");
            }
            else
            {
                // Overlay only the fields this form exposes onto the full DTO already in hand —
                // every other field round-trips unchanged instead of being wiped to null (this
                // form doesn't surface DateOfBirth/MaritalStatus/AlternatePhone/District/Province/
                // DependentsCount/HouseholdSize/Notes/GrandfatherName/AncestralVillage/
                // FatherMembershipNumber/WhatsappNumber at all).
                var existing = _editingApplicant!;
                await ApiClient.UpdateApplicantAsync(_editingId.Value, new UpdateApplicantRequest(
                    MembershipNumber: _form.MembershipNumber,
                    FullName: _form.FullName,
                    FatherOrHusbandName: _form.FatherOrHusbandName,
                    Cnic: _form.Cnic,
                    Gender: _form.Gender,
                    DateOfBirth: existing.DateOfBirth,
                    MaritalStatus: existing.MaritalStatus,
                    Phone: _form.Phone,
                    AlternatePhone: existing.AlternatePhone,
                    Email: _form.Email,
                    Address: _form.Address,
                    City: _form.City,
                    District: existing.District,
                    Province: existing.Province,
                    Occupation: _form.Occupation,
                    MonthlyIncome: _form.MonthlyIncome,
                    DependentsCount: existing.DependentsCount,
                    HouseholdSize: existing.HouseholdSize,
                    IsBlacklisted: _form.IsBlacklisted,
                    BlacklistReason: _form.BlacklistReason,
                    Notes: existing.Notes,
                    GrandfatherName: existing.GrandfatherName,
                    Surname: _form.Surname,
                    AncestralVillage: existing.AncestralVillage,
                    FatherMembershipNumber: existing.FatherMembershipNumber,
                    WhatsappNumber: existing.WhatsappNumber));
                Toast.Success($"Applicant updated · {_form.FullName}");
            }

            _showForm = false;
            await LoadPageAsync(_currentPage);
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void RequestBlacklist(ApplicantDto applicant)
    {
        _applicantPendingBlacklist = applicant;
        _confirmOpen = true;
    }

    private async Task BlacklistConfirmedAsync()
    {
        if (_applicantPendingBlacklist is null)
        {
            return;
        }

        try
        {
            await ApiClient.UpdateApplicantAsync(_applicantPendingBlacklist.Id, new UpdateApplicantRequest(
                MembershipNumber: _applicantPendingBlacklist.MembershipNumber,
                FullName: _applicantPendingBlacklist.FullName,
                FatherOrHusbandName: _applicantPendingBlacklist.FatherOrHusbandName,
                Cnic: _applicantPendingBlacklist.Cnic,
                Gender: _applicantPendingBlacklist.Gender,
                DateOfBirth: _applicantPendingBlacklist.DateOfBirth,
                MaritalStatus: _applicantPendingBlacklist.MaritalStatus,
                Phone: _applicantPendingBlacklist.Phone,
                AlternatePhone: _applicantPendingBlacklist.AlternatePhone,
                Email: _applicantPendingBlacklist.Email,
                Address: _applicantPendingBlacklist.Address,
                City: _applicantPendingBlacklist.City,
                District: _applicantPendingBlacklist.District,
                Province: _applicantPendingBlacklist.Province,
                Occupation: _applicantPendingBlacklist.Occupation,
                MonthlyIncome: _applicantPendingBlacklist.MonthlyIncome,
                DependentsCount: _applicantPendingBlacklist.DependentsCount,
                HouseholdSize: _applicantPendingBlacklist.HouseholdSize,
                IsBlacklisted: true,
                BlacklistReason: "Blacklisted by admin",
                Notes: _applicantPendingBlacklist.Notes,
                GrandfatherName: _applicantPendingBlacklist.GrandfatherName,
                Surname: _applicantPendingBlacklist.Surname,
                AncestralVillage: _applicantPendingBlacklist.AncestralVillage,
                FatherMembershipNumber: _applicantPendingBlacklist.FatherMembershipNumber,
                WhatsappNumber: _applicantPendingBlacklist.WhatsappNumber));
            Toast.Success($"Applicant blacklisted · {_applicantPendingBlacklist.FullName}");
            await LoadPageAsync(_currentPage);
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private class ApplicantFormModel
    {
        [Required] public string FullName { get; set; } = "";
        public string? Surname { get; set; }
        public string? FatherOrHusbandName { get; set; }
        [Required] public string Cnic { get; set; } = "";
        // Nullable to match ApplicantDto.Gender (F5) — a Google-Form-originated applicant may have
        // none on file. Staff create still requires a value (enforced in SaveAsync, since this
        // model is shared with edit, where null must stay a valid save — see the class doc above).
        // Defaults to "Male" only for the create-modal's pre-filled first value; edit mode overwrites
        // it from the loaded applicant, including null, in OpenEditModal.
        public string? Gender { get; set; } = "Male";
        public string? MembershipNumber { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Address { get; set; }
        public string? City { get; set; }
        public string? Occupation { get; set; }
        public decimal? MonthlyIncome { get; set; }
        public bool IsBlacklisted { get; set; }
        public string? BlacklistReason { get; set; }
    }

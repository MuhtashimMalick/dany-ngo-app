                MembershipNumber: _applicantPendingBlacklist.MembershipNumber,
                FullName: _applicantPendingBlacklist.FullName,
                FatherOrHusbandName: _applicantPendingBlacklist.FatherOrHusbandName,
                Cnic: _applicantPendingBlacklist.Cnic,

                MaritalStatus: _applicantPendingBlacklist.MaritalStatus,
                Phone: _applicantPendingBlacklist.Phone,
                AlternatePhone: _applicantPendingBlacklist.AlternatePhone,
                Email: _applicantPendingBlacklist.Email,
                Address: _applicantPendingBlacklist.Address,
                City: _applicantPendingBlacklist.City,
                District: _applicantPendingBlacklist.District,
                Province: _applicantPendingBlacklist.Province,
                Occupation: _applicantPendingBlacklist.Occupation,
                MonthlyIncome: _applicantPendingBlacklist.MonthlyIncome,
                DependentsCount: _applicantPendingBlacklist.DependentsCount,
                HouseholdSize: _applicantPendingBlacklist.HouseholdSize,
                IsBlacklisted: true,

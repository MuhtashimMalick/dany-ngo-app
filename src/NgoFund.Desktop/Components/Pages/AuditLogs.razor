@page "/audit-logs"
@inject ApiClient ApiClient
@inject IJSRuntime JS

<FilterBar>
    <SearchBox @bind-Value="_search" OnSearch="() => LoadPageAsync(1)" Placeholder="Search activity or user…" />
    <div class="filter-bar-actions">
        <button type="button" id="download-jsonl-btn" class="btn btn-secondary" disabled="@_isExporting" @onclick="ExportAsync">
            <Icon Name="download" Size="16" />@(_isExporting ? "Downloading..." : "Download JSONL")
        </button>
    </div>
</FilterBar>

@if (_errorMessage is not null)
{
    <div class="alert alert-error">@_errorMessage</div>
}

<DataTable TItem="ActivityLogDto" Items="_page?.Items ?? []" IsLoading="_page is null" ShowPagination="true"
           Page="_currentPage" PageSize="PageSize" TotalCount="_page?.TotalCount ?? 0"
           OnPageChange="LoadPageAsync" RowsContainerId="audit-log-rows" EmptyText="No activity recorded yet."
           EmptyDescription="Changes to donors, applications, payments and loans will appear here." EmptyIcon="audit">
    <HeaderRow>
        <th>Activity</th>
        <th>User</th>
        <th class="num">When</th>
    </HeaderRow>
    <RowTemplate Context="entry">
        <tr>
            <td>@entry.Summary</td>
            <td>@(entry.UserName ?? "System")</td>
            <td class="num">@entry.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
        </tr>
    </RowTemplate>
</DataTable>

@code {
    private const int PageSize = 25;
    private PagedResult<ActivityLogDto>? _page;
    private int _currentPage = 1;
    private string _search = "";
    private string? _errorMessage;
    private bool _pendingRowAnimation;
    private bool _isExporting;

    protected override async Task OnInitializedAsync() => await LoadPageAsync(1);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingRowAnimation)
        {
            _pendingRowAnimation = false;
            await JS.InvokeVoidAsync("ngoFundMotion.animateTableRows", "#audit-log-rows tr");
        }
    }

    private async Task LoadPageAsync(int page)
    {
        _errorMessage = null;
        try
        {
            _page = await ApiClient.GetActivityLogAsync(page, PageSize, string.IsNullOrWhiteSpace(_search) ? null : _search);
            _currentPage = page;
            _pendingRowAnimation = true;
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    // search is passed through exactly as the list load uses it — the server derives the export
    // filename itself, same pattern as FundTransactionLedgerTable's ExportAsync.
    private async Task ExportAsync()
    {
        _errorMessage = null;
        _isExporting = true;
        const string iconSelector = "#download-jsonl-btn svg";
        await JS.InvokeVoidAsync("ngoFundMotion.startButtonSpin", iconSelector);
        try
        {
            var (bytes, fileName) = await ApiClient.ExportActivityLogAsync(string.IsNullOrWhiteSpace(_search) ? null : _search);
            await JS.InvokeVoidAsync("ngoFundFiles.downloadBase64", Convert.ToBase64String(bytes), fileName, "application/x-ndjson");
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isExporting = false;
            await JS.InvokeVoidAsync("ngoFundMotion.stopButtonSpin", iconSelector);
        }
    }
}

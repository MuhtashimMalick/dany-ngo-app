@page "/audit-logs"
@inject ApiClient ApiClient
@inject IJSRuntime JS

<FilterBar>
    <SearchBox @bind-Value="_search" OnSearch="() => LoadPageAsync(1)" Placeholder="Search by entity or user…" />
</FilterBar>

@if (_errorMessage is not null)
{
    <div class="alert alert-error">@_errorMessage</div>
}

<DataTable TItem="AuditLogDto" Items="_page?.Items ?? []" IsLoading="_page is null" ShowPagination="true"
           Page="_currentPage" PageSize="PageSize" TotalCount="_page?.TotalCount ?? 0"
           OnPageChange="LoadPageAsync" RowsContainerId="audit-log-rows" EmptyText="No audit log entries found."
           EmptyDescription="Activity across the app will appear here." EmptyIcon="audit">
    <HeaderRow>
        <th>When</th>
        <th>User</th>
        <th>Action</th>
        <th>Entity</th>
        <th>Entity Id</th>
        <th>Changed Columns</th>
    </HeaderRow>
    <RowTemplate Context="entry">
        <tr>
            <td>@entry.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
            <td>@(entry.UserName ?? "System")</td>
            <td>@entry.Action</td>
            <td>@entry.EntityName</td>
            <td>@entry.EntityId</td>
            <td>@(entry.ChangedColumns is { Count: > 0 } cols ? string.Join(", ", cols) : "-")</td>
        </tr>
    </RowTemplate>
</DataTable>

@code {
    private const int PageSize = 25;
    private PagedResult<AuditLogDto>? _page;
    private int _currentPage = 1;
    private string _search = "";
    private string? _errorMessage;
    private bool _pendingRowAnimation;

    protected override async Task OnInitializedAsync() => await LoadPageAsync(1);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingRowAnimation)
        {
            _pendingRowAnimation = false;
            await JS.InvokeVoidAsync("ngoFundMotion.animateTableRows", "#audit-log-rows tr");
        }
    }

    private async Task LoadPageAsync(int page)
    {
        _errorMessage = null;
        try
        {
            _page = await ApiClient.GetAuditLogsAsync(page, PageSize, string.IsNullOrWhiteSpace(_search) ? null : _search);
            _currentPage = page;
            _pendingRowAnimation = true;
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
    }
}

@page "/applications"
@inject ApiClient ApiClient
@inject AuthState AuthState
@inject ToastService Toast
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IntakeNotificationState IntakeState

<div class="page-header">
    @if (AuthState.HasPermission("applications.create"))
    {
        <SectionContent SectionName="page-actions">
            <button class="btn btn-primary" @onclick="OpenCreateWizard">New Application</button>
        </SectionContent>
    }
</div>

<FilterBar>
    <SearchBox @bind-Value="_search" OnSearch="() => LoadPageAsync(1)" Placeholder="Search by app #, membership #, name, CNIC…" />
    <div class="field filter-field-md mb-0">
        <label for="statusFilter">Status</label>
        <select id="statusFilter" @bind="_statusFilter" @bind:after="() => LoadPageAsync(1)">
            <option value="">All statuses</option>
            @foreach (var status in Statuses)
            {
                <option value="@status">@status</option>
            }
        </select>
    </div>
    <div class="field filter-field-lg mb-0">
        <label for="categoryFilter">Category</label>
        <select id="categoryFilter" @bind="_categoryFilter" @bind:after="() => LoadPageAsync(1)">
            <option value="">All categories</option>
            @foreach (var category in _categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>
    <div class="field filter-field-sm mb-0">
        <label for="dateFromFilter">From</label>
        <input id="dateFromFilter" type="date" @bind="_dateFromFilter" @bind:after="() => LoadPageAsync(1)" />
    </div>
    <div class="field filter-field-sm mb-0">
        <label for="dateToFilter">To</label>
        <input id="dateToFilter" type="date" @bind="_dateToFilter" @bind:after="() => LoadPageAsync(1)" />
    </div>
    <div class="field filter-field-md mb-0">
        <label for="channelFilter">Channel</label>
        <select id="channelFilter" @bind="_channelFilter" @bind:after="() => LoadPageAsync(1)">
            <option value="">All channels</option>
            <option value="InApp">In-App</option>
            <option value="GoogleForm">Google Form</option>
        </select>
    </div>
</FilterBar>

@if (_newIntakeBannerCount > 0 && !_intakeBannerDismissed)
{
    <div class="alert alert-info" id="@IntakeBannerId" role="status">
        <Icon Name="info" Size="16" />
        <span class="flex-1">@_newIntakeBannerCount new Google Form application@(_newIntakeBannerCount == 1 ? "" : "s") since your last visit</span>
        <button type="button" class="btn btn-secondary btn-sm" @onclick="ShowNewIntakeApplicationsAsync">Show them</button>
        <button type="button" class="icon-btn" aria-label="Dismiss" @onclick="() => _intakeBannerDismissed = true">
            <Icon Name="close" Size="14" />
        </button>
    </div>
}

<FilterChips Filters="ActiveFilters" OnClearAll="ClearAllFiltersAsync" />

@if (_errorMessage is not null)
{
    <div class="alert alert-error">@_errorMessage</div>
}

<DataTable TItem="ApplicationDto" Items="_page?.Items ?? []" IsLoading="_page is null" ShowPagination="true"
           Page="_currentPage" PageSize="PageSize" TotalCount="_page?.TotalCount ?? 0"
           OnPageChange="LoadPageAsync" RowsContainerId="applications-rows" EmptyText="No applications found."
           EmptyDescription="Applications you record will appear here." EmptyIcon="applications">
    <HeaderRow>
        <th>App #</th>
        <th>Channel</th>
        <th>Applicant</th>
        <th>Category</th>
        <th>Fund</th>
        <th class="num">Requested (PKR)</th>
        <th class="num">Approved (PKR)</th>
        <th>Priority</th>
        <th>Status</th>
        <th>Date</th>
        <th></th>
    </HeaderRow>
    <RowTemplate Context="application">
        <tr>
            <td>@application.ApplicationNumber</td>
            <td><IntakeChannelChip Channel="@application.IntakeChannel" /></td>
            <td>
                <span class="flex items-center gap-2">
                    @application.ApplicantName
                    @if (application.ActiveApplicationCount > 1)
                    {
                        <span title="@($"This applicant has {application.ActiveApplicationCount} active applications")">
                            <StatusBadge Status="Warning" Text="@($"{application.ActiveApplicationCount} active")" />
                        </span>
                    }
                    @if (HasUnresolvedApplicantConflict(application))
                    {
                        <span title="@($"This applicant is also a guarantor on: {string.Join(", ", application.ApplicantGuarantorConflictApplicationNumbers)}")">
                            <StatusBadge Status="Warning" Text="Guarantor elsewhere" />
                        </span>
                    }
                </span>
            </td>
            <td>@application.ApplicationCategoryName</td>
            <td>@application.FundCategoryName</td>
            <td class="num">@(application.RequestedAmount?.ToString("N2") ?? "Not stated")</td>
            <td class="num">@(application.ApprovedAmount?.ToString("N2") ?? "-")</td>
            <td>@application.Priority</td>
            <td><StatusBadge Status="@application.Status" /></td>
            <td>@application.ApplicationDate.ToString("yyyy-MM-dd")</td>
            @* `.table-actions` (display:flex) lives on an inner <div>, not directly on the <td>.
               Setting display:flex/grid straight on a table-associated element (td/tr/etc.) forces
               the browser to wrap it in an anonymous table-cell box per the CSS Display Level 3
               spec ("Displaying Table-related elements") to keep the row's table structure intact
               — an edge case whose sizing has historically varied across Chromium builds/versions.
               Since WebView2's bundled Chromium version can differ from whatever Chromium a
               dev/test machine has, relying on that anonymous-box behavior for a real table cell is
               fragile. A plain inner div keeps the <td> a normal, predictably-sized table cell and
               scopes the flex layout to content only. *@
            <td>
                <div class="table-actions">
                    <button class="icon-btn" aria-label="Manage application" @onclick="() => OpenManageModalAsync(application)"><Icon Name="eye" Size="16" /></button>
                </div>
            </td>
        </tr>
    </RowTemplate>
</DataTable>

@if (_showCreateWizard)
{
    <ApplicationWizard Categories="_categories" Funds="_funds" OnClosed="CloseCreateWizardAsync" />
}

@if (_managing is not null)
{
    <Modal Title="@($"{_managing.ApplicationNumber} — {_managing.ApplicantName}")" Size="lg" OnClose="CloseManageModal">
        <SubHeader>
            <div class="application-summary-header">
                <div class="application-summary-main">
                    <span class="application-summary-name">@_managing.ApplicantName</span>
                    <span class="application-summary-number">@_managing.ApplicationNumber</span>
                    <StatusBadge Status="@_managing.Status" />
                </div>
                <div class="application-summary-amounts">
                    <div>
                        <div class="fund-balance-col-label">Requested</div>
                        <div class="fund-balance-col-value">@(_managing.RequestedAmount?.ToString("N2") ?? "Not stated")</div>
                    </div>
                    <div>
                        <div class="fund-balance-col-label">Approved</div>
                        <div class="fund-balance-col-value">@(_managing.ApprovedAmount?.ToString("N2") ?? "-")</div>
                    </div>
                    <div>
                        <div class="fund-balance-col-label">Remaining</div>
                        <div class="fund-balance-col-value">@(PaymentsRemaining?.ToString("N2") ?? "-")</div>
                    </div>
                </div>
            </div>
        </SubHeader>
        <ChildContent>
        @if (_manageError is not null)
        {
            <div class="alert alert-error">@_manageError</div>
        }

        <Tabs AriaLabel="Application details">
            <TabPanel Title="Details">
                <DetailList>
                    <DetailItem Label="Category" Value="@_managing.ApplicationCategoryName" />
                    <DetailItem Label="Fund" Value="@_managing.FundCategoryName" />
                    <DetailItem Label="Priority" Value="@_managing.Priority" />
                    <DetailItem Label="Intake Channel">
                        <IntakeChannelChip Channel="@_managing.IntakeChannel" />
                    </DetailItem>
                    @if (_managing.IntakeChannel == "GoogleForm")
                    {
                        <DetailItem Label="Google Form response ID">
                            <span class="copy-affordance">
                                <span class="mono-text">@(_managing.ExternalFormReference ?? "-")</span>
                                @if (!string.IsNullOrEmpty(_managing.ExternalFormReference))
                                {
                                    <button type="button" class="copy-btn @(_copiedResponseReference ? "copied" : "")"
                                            aria-label="Copy Google Form response ID" title="Copy response ID" @onclick="CopyResponseReferenceAsync">
                                        <Icon Name="@(_copiedResponseReference ? "check-circle" : "copy")" Size="14" />
                                    </button>
                                }
                            </span>
                        </DetailItem>
                        <DetailItem Label="Submitted">
                            @if (_managing.SubmittedAt is { } submittedAt)
                            {
                                <span title="@submittedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")">@submittedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") (@RelativeTimeFormat.From(submittedAt))</span>
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </DetailItem>
                    }
                    <DetailItem Label="Purpose" Value="@_managing.Purpose" SpanFull="true" />
                </DetailList>

                @if (_managing.IntakeChannel == "GoogleForm" && (_managing.DeclarationAcceptedAt is null || _managing.TermsAcceptedAt is null))
                {
                    <div class="alert alert-warning">
                        <Icon Name="alert-circle" Size="16" />
                        <span>This Google Form application arrived without recorded terms/declaration acceptance — staff must capture it@(CategoryHasManifest ? " (see Completeness below)" : "").</span>
                    </div>
                }

                @if (CategoryHasManifest)
                {
                    <FormSection Title="Completeness">
                        <CompletenessChecklist Completeness="_completeness" IsLoading="_isCompletenessLoading" />
                    </FormSection>
                }

                @switch (CategoryCapabilities.DetailsSectionKind(_managing.ApplicationCategoryCode))
                {
                    case CategoryDetailsSectionKind.Housing:
                        <HousingDetailsSection ApplicationId="_managing.Id" @key="_managing.Id" />
                        break;
                    case CategoryDetailsSectionKind.Marriage:
                        <MarriageDetailsSection ApplicationId="_managing.Id" @key="_managing.Id" />
                        break;
                    case CategoryDetailsSectionKind.BusinessLoan:
                        <BusinessLoanDetailsSection ApplicationId="_managing.Id" RequestedAmount="_managing.RequestedAmount" @key="_managing.Id" />
                        break;
                    case CategoryDetailsSectionKind.Education:
                        <EducationDetailsSection ApplicationId="_managing.Id" @key="_managing.Id" />
                        break;
                    case CategoryDetailsSectionKind.Health:
                        <HealthDetailsSection ApplicationId="_managing.Id" @key="_managing.Id" />
                        break;
                }

                @if (AuthState.HasPermission("applications.review"))
                {
                    <FormSection Title="Change Status">
                        @if (HasUnresolvedApplicantConflict(_managing))
                        {
                            <div class="alert alert-warning" id="@ApplicantConflictBannerId"
                                 title="@($"This applicant is also a guarantor on: {string.Join(", ", _managing.ApplicantGuarantorConflictApplicationNumbers)}")">
                                <Icon Name="alert-circle" Size="16" />
                                <span>
                                    This applicant is also a guarantor on @(_managing.ApplicantGuarantorConflictApplicationNumbers.Count == 1 ? "another active application" : "other active applications"):
                                    <strong>@string.Join(", ", _managing.ApplicantGuarantorConflictApplicationNumbers)</strong>.
                                    @if (CanOverrideApplicantConflict)
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm" style="margin-left: var(--space-3);" @onclick="OpenApplicantConflictOverrideModal">Approve override</button>
                                    }
                                </span>
                            </div>
                        }
                        else if (_managing.ApplicantGuarantorConflictOverrideApprovedAt is not null)
                        {
                            <p class="field-hint">
                                Conflict override approved by @(_managing.ApplicantGuarantorConflictOverrideApprovedByName ?? "—") on @_managing.ApplicantGuarantorConflictOverrideApprovedAt.Value.ToLocalTime().ToString("yyyy-MM-dd")
                                @(string.IsNullOrWhiteSpace(_managing.ApplicantGuarantorConflictOverrideReason) ? "" : $" — \"{_managing.ApplicantGuarantorConflictOverrideReason}\"")
                            </p>
                        }

                        @if (_managing.AllowedNextStatuses.Count == 0)
                        {
                            <p class="field-hint">No further manual status changes are available right now.</p>
                        }
                        else
                        {
                            <div class="flex gap-3 items-start flex-wrap">
                                <div class="field w-200 mb-0">
                                    <label for="newStatus">New status</label>
                                    <select id="newStatus" @bind="_newStatus" @bind:after="OnNewStatusChanged">
                                        @foreach (var status in _managing.AllowedNextStatuses)
                                        {
                                            <option value="@status">@status</option>
                                        }
                                    </select>
                                </div>
                                <div class="field flex-1 min-w-200 mb-0">
                                    <label for="statusRemarks">Remarks</label>
                                    <input id="statusRemarks" @bind="_statusRemarks" />
                                </div>
                                @if (_newStatus == "Rejected")
                                {
                                    <div class="field flex-1 min-w-200 mb-0">
                                        <label for="rejectionReason">Rejection reason</label>
                                        <input id="rejectionReason" @bind="_rejectionReason" />
                                    </div>
                                }
                                @if (_newStatus == "Approved")
                                {
                                    <div class="field flex-1 min-w-200 mb-0">
                                        <label for="approvedAmount">Approved Amount (PKR)</label>
                                        <input id="approvedAmount" type="number" step="0.01" min="0" @bind="_approvedAmount" />
                                        @if (ApprovedAmountError is not null)
                                        {
                                            <span class="field-error">@ApprovedAmountError</span>
                                        }
                                        else
                                        {
                                            <span class="field-hint">Requested: @(_managing.RequestedAmount is { } requested ? $"PKR {requested:N2}" : "not stated")</span>
                                            @if (_approvedAmount > _managing.RequestedAmount)
                                            {
                                                <span class="field-hint">PKR @((_approvedAmount - _managing.RequestedAmount)?.ToString("N2")) above the requested amount</span>
                                            }
                                        }
                                    </div>
                                }
                                <div class="field mb-0">
                                    @* Invisible label matching the other fields' label height/gap so the button's
                                       36px height (same as .field > input/select) lines up with the row's inputs
                                       under items-start, regardless of which field grows taller from an error/hint
                                       line below it. See app.css .field for the label+gap+input stack this mirrors. *@
                                    <label aria-hidden="true" style="visibility: hidden;">Apply</label>
                                    <button class="btn btn-primary" @onclick="ChangeStatusAsync" disabled="@(_isChangingStatus || ApproveBlockedByCompleteness || ApproveBlockedByAmount || ApproveBlockedByApplicantConflict || ApproveBlockedByGuarantorConflict)">Apply</button>
                                </div>
                            </div>
                            @if (ApproveBlockedByCompleteness)
                            {
                                <p class="field-error">This application is missing required information/documents — see Completeness above — and cannot be moved to Approved yet.</p>
                            }
                            @if (ApproveBlockedByApplicantConflict)
                            {
                                <p class="field-error">This applicant is also an active guarantor elsewhere — approve the override above before proceeding.</p>
                            }
                            @if (ApproveBlockedByGuarantorConflict)
                            {
                                <p class="field-error">One or more guarantors have an unresolved CNIC conflict — resolve it on the Guarantors tab before proceeding.</p>
                            }
                        }
                    </FormSection>
                }

                <FormSection Title="History">
                    @if (_history.Count == 0)
                    {
                        <EmptyState Icon="applications" Title="No history yet" Description="Status changes will appear here." />
                    }
                    else
                    {
                        <ul class="timeline">
                            @foreach (var entry in _history.OrderByDescending(h => h.ChangedAt))
                            {
                                <li class="timeline-item">
                                    <span class="timeline-marker"></span>
                                    <div class="timeline-content">
                                        <div class="timeline-transition">
                                            @(entry.FromStatus is null ? "Created as" : $"{entry.FromStatus} →")
                                            <StatusBadge Status="@entry.ToStatus" />
                                        </div>
                                        <div class="timeline-meta" title="@entry.ChangedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")">@RelativeTimeFormat.From(entry.ChangedAt)</div>
                                        @if (!string.IsNullOrEmpty(entry.Remarks))
                                        {
                                            <div class="timeline-remarks">@entry.Remarks</div>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </FormSection>

                <FormSection Title="Remarks">
                    @if (_remarks.Count == 0)
                    {
                        <EmptyState Icon="applications" Title="No remarks yet" />
                    }
                    else
                    {
                        <div>
                            @foreach (var remark in _remarks.OrderByDescending(r => r.CreatedAt))
                            {
                                <div class="remark-item">
                                    <div class="remark-header">
                                        <span title="@remark.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")">@RelativeTimeFormat.From(remark.CreatedAt)</span>
                                        @if (remark.IsInternal)
                                        {
                                            <span class="badge badge-internal">Internal</span>
                                        }
                                    </div>
                                    <div class="remark-body">@remark.Remark</div>
                                </div>
                            }
                        </div>
                    }
                    @if (AuthState.HasPermission("applications.edit"))
                    {
                        <div class="remark-composer">
                            <div class="field flex-1 mb-0">
                                <label for="newRemarkText">Add a remark</label>
                                <input id="newRemarkText" @bind="_newRemark" />
                            </div>
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="_newRemarkIsInternal" /> Internal
                            </label>
                            <button class="btn btn-secondary" @onclick="AddRemarkAsync">Add</button>
                        </div>
                    }
                </FormSection>
            </TabPanel>

            @if (ShowGuarantorsTab)
            {
                <TabPanel Title="@($"Guarantors ({_guarantorCount}/{_managing.RequiresGuarantors})")">
                    <GuarantorsEditor ApplicationId="_managing.Id" RequiredCount="_managing.RequiresGuarantors"
                                      Slots="_completeness?.Slots ?? []" OnViewDocument="doc => _viewingDocument = doc"
                                      OnGuarantorsChanged="ReloadManageDataAsync"
                                      OnCountChanged="c => _guarantorCount = c"
                                      OnConflictStateChanged="hasConflict => _hasUnresolvedGuarantorConflict = hasConflict" @key="_managing.Id" />
                </TabPanel>
            }

            @if (AuthState.HasPermission("payments.view"))
            {
                <TabPanel Title="@($"Payments ({_payments.Count})")">
                    <FormSection Title="Payment History">
                        <div class="card payment-summary-card">
                            <div>
                                <div class="fund-balance-col-label">Approved</div>
                                <div class="fund-balance-col-value">@(_managing.ApprovedAmount?.ToString("N2") ?? "-")</div>
                            </div>
                            <div>
                                <div class="fund-balance-col-label">Paid</div>
                                <div class="fund-balance-col-value">@PaymentsPaid.ToString("N2")</div>
                            </div>
                            <div>
                                <div class="fund-balance-col-label">Remaining</div>
                                <div class="fund-balance-col-value">@(PaymentsRemaining?.ToString("N2") ?? "-")</div>
                            </div>
                        </div>

                        @if (_payments.Count == 0)
                        {
                            <EmptyState Icon="payments" Title="No payments recorded yet" />
                        }
                        else
                        {
                            <div class="table-wrapper">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Number</th>
                                            <th>Date</th>
                                            <th class="num">Amount (PKR)</th>
                                            <th>Method</th>
                                            <th>Status</th>
                                            <th>Void Reason</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var payment in _payments.OrderByDescending(p => p.PaymentDate))
                                        {
                                            <tr>
                                                <td>@payment.PaymentNumber</td>
                                                <td>@payment.PaymentDate.ToString("yyyy-MM-dd")</td>
                                                <td class="num">@payment.Amount.ToString("N2")</td>
                                                <td>@payment.PaymentMethod</td>
                                                <td><StatusBadge Status="@payment.Status" /></td>
                                                <td>@(payment.Status == "Voided" ? (payment.VoidReason ?? "-") : "-")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </FormSection>
                </TabPanel>
            }

            @if (_managing.RequiresLoanPlan || _managing.LoanAgreementId is not null)
            {
                @* RequiresLoanPlan alone flips false once an Active agreement exists (it gates
                   payments, not this panel) — see LoanSchedulePanel's IsGeneralFundApplication doc
                   comment for why both fields are checked here. Wrapping the TabPanel itself in
                   this same condition (not just LoanSchedulePanel's own internal check) is what
                   keeps the Installments tab out of the DOM entirely for Zakat-fund applications,
                   per Tabs.razor's dynamic-registration design. *@
                <TabPanel Title="Installments">
                    <LoanSchedulePanel ApplicationId="_managing.Id"
                                        IsGeneralFundApplication="_managing.RequiresLoanPlan || _managing.LoanAgreementId is not null"
                                        @key="_managing.Id" />
                </TabPanel>
            }

            <TabPanel Title="@($"Documents ({_documents.Count})")">
                <FormSection Title="Documents">
                    <DocumentSlotList ApplicationId="_managing.Id" ApplicantId="_managing.ApplicantId" Slots="_completeness?.Slots ?? []"
                                       ExtraDocuments="_documents.Where(d => d.SlotKey is null).ToList()"
                                       ShowGuarantorSlots="!ShowGuarantorsTab"
                                       OnChanged="ReloadManageDataAsync" OnViewDocument="doc => _viewingDocument = doc" />
                </FormSection>
            </TabPanel>
        </Tabs>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseManageModal">Close</button>
        </Footer>
    </Modal>
}

@if (_showApplicantConflictOverrideModal && _managing is not null)
{
    <Modal Title="@($"Approve Conflict Override — {_managing.ApplicantName}")" Size="sm" OnClose="CloseApplicantConflictOverrideModal">
        <ChildContent>
            <p>
                This applicant also appears as a guarantor on <strong>@string.Join(", ", _managing.ApplicantGuarantorConflictApplicationNumbers)</strong>.
                Approving lets this application proceed toward Approved despite the conflict.
            </p>
            <div class="field mb-0">
                <label for="applicantConflictOverrideReason">Reason *</label>
                <textarea id="applicantConflictOverrideReason" @bind="_applicantConflictOverrideReason"></textarea>
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseApplicantConflictOverrideModal">Cancel</button>
            <button type="button" class="btn btn-primary" disabled="@(_isSavingApplicantConflictOverride || string.IsNullOrWhiteSpace(_applicantConflictOverrideReason))" @onclick="ConfirmApplicantConflictOverrideAsync">
                @(_isSavingApplicantConflictOverride ? "Approving..." : "Approve Override")
            </button>
        </Footer>
    </Modal>
}

<DocumentViewer Document="_viewingDocument" OnClose="() => _viewingDocument = null" />

@code {
    private static readonly string[] Statuses =
        ["Pending", "UnderReview", "Approved", "Rejected", "Paid", "PartiallyPaid", "OnHold"];

    [SupplyParameterFromQuery(Name = "applicationId")]
    [Parameter]
    public Guid? ApplicationIdQuery { get; set; }

    // F4 (redesign): deep-link filters from the intake toast (MainLayout) —
    // "/applications?intakeChannel=GoogleForm" (status is no longer part of that link; see
    // MainLayout's GoogleFormFilterPath). Applied once per distinct incoming value (see
    // OnParametersSetAsync) rather than on every parameter-set, so a filter the user clears
    // manually afterward doesn't keep getting reapplied on unrelated re-renders. A plain visit to
    // "/applications" (no query string) instead shows the "Show them" banner below when there are
    // unread Google Form applications — see OnInitializedAsync's MarkSeenAsync call.
    [SupplyParameterFromQuery(Name = "status")]
    [Parameter]
    public string? StatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "intakeChannel")]
    [Parameter]
    public string? IntakeChannelQuery { get; set; }

    private const int PageSize = 25;
    private PagedResult<ApplicationDto>? _page;
    private int _currentPage = 1;
    private string _search = "";
    private string _statusFilter = "";
    private string _categoryFilter = "";
    private string _channelFilter = "";
    private DateOnly? _dateFromFilter;
    private DateOnly? _dateToFilter;
    private string? _errorMessage;
    private bool _pendingRowAnimation;
    private Guid? _autoOpenedApplicationId;
    private string? _lastAppliedStatusQuery;
    private string? _lastAppliedIntakeChannelQuery;

    // F4 (redesign): "N new Google Form applications since your last visit" banner, shown only when
    // the user arrived at a plain "/applications" (no intakeChannel query — that means they came via
    // the toast's deep link already, which applies the filter itself; showing the banner too would
    // be redundant). Set once in OnInitializedAsync from IntakeNotificationState.MarkSeenAsync's
    // return value.
    private int _newIntakeBannerCount;
    private bool _intakeBannerDismissed;
    private bool _pendingIntakeBannerAnimation;
    private const string IntakeBannerId = "new-intake-banner";

    private IReadOnlyList<ApplicationCategoryDto> _categories = [];
    private IReadOnlyList<FundCategoryDto> _funds = [];

    private bool _showCreateWizard;

    private ApplicationDto? _managing;

    // Single source of truth for "does this application get a Guarantors tab" — reused to decide
    // whether the Documents tab should suppress guarantor-scoped slots (ShowGuarantorSlots on
    // DocumentSlotList below), so a future category can never end up with guarantor slots hidden
    // from Documents with no Guarantors tab to show them in instead.
    private bool ShowGuarantorsTab => _managing?.ApplicationCategoryCode == "ROZGAR";

    private bool _showApplicantConflictOverrideModal;
    private bool _isSavingApplicantConflictOverride;
    private string _applicantConflictOverrideReason = "";
    private bool _pendingApplicantConflictAnimation;

    private string ApplicantConflictBannerId => $"applicant-conflict-banner-{_managing?.Id:N}";

    // F2: transient "copied" state for the Google Form response ID's copy-to-clipboard affordance
    // in the detail view above — flips the icon to a checkmark for a moment, then reverts.
    private bool _copiedResponseReference;

    private async Task CopyResponseReferenceAsync()
    {
        if (_managing?.ExternalFormReference is not { } reference)
        {
            return;
        }

        await JS.InvokeVoidAsync("ngoFundClipboard.copy", reference);
        _copiedResponseReference = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copiedResponseReference = false;
        StateHasChanged();
    }

    private string? _manageError;
    private IReadOnlyList<ApplicationStatusHistoryDto> _history = [];
    private IReadOnlyList<ApplicationRemarkDto> _remarks = [];
    private IReadOnlyList<DocumentDto> _documents = [];
    private IReadOnlyList<PaymentDto> _payments = [];
    private DocumentDto? _viewingDocument;
    private string _newStatus = "";
    private string _statusRemarks = "";
    private string _rejectionReason = "";
    private decimal? _approvedAmount;
    private bool _isChangingStatus;
    private string _newRemark = "";
    private bool _newRemarkIsInternal;

    // Completeness backs both the manage modal's inline checklist and the Approve-gate below —
    // fetched alongside history/remarks/documents/payments in ReloadManageDataAsync so it's never
    // stale relative to what the user is looking at. Every category except EMERGENCY carries a
    // document manifest — see CategoryCapabilities.HasManifest, the single source of truth for this
    // (also used by ApplicationWizard.razor).
    private ApplicationCompletenessDto? _completeness;
    private bool _isCompletenessLoading;

    private bool CategoryHasManifest => CategoryCapabilities.HasManifest(_managing?.ApplicationCategoryCode);

    // Client-side mirror of the server's Approved-transition completeness gate (already enforced
    // API-side as the backstop) — disables the Apply button and shows why inline, rather than
    // letting staff hit a 422 with no context after clicking.
    private bool ApproveBlockedByCompleteness =>
        _newStatus == "Approved" && CategoryHasManifest && _completeness is { IsComplete: false };

    // Item 1 (2026-09 feedback): the server no longer defaults ApprovedAmount to RequestedAmount —
    // it requires an explicit value the first time an application is approved (re-approval from
    // OnHold may omit it to keep the existing value, but staff editing the field here always sends
    // one).
    // v1.8 correction: the requested amount is deliberately NOT a ceiling on the approved amount —
    // approval goes through a committee of elders who may approve less than, equal to, or more
    // than what was requested. (The matching DB CHECK constraint, domain exception, and validator
    // rule are being dropped server-side in the same round.) The only client-side gate left is that
    // an explicit positive amount is required before Approve is allowed.
    private string? ApprovedAmountError
    {
        get
        {
            if (_newStatus != "Approved" || _managing is null)
            {
                return null;
            }
            if (_approvedAmount is null || _approvedAmount <= 0)
            {
                return "Enter an approved amount greater than zero.";
            }
            return null;
        }
    }

    private bool ApproveBlockedByAmount => _newStatus == "Approved" && ApprovedAmountError is not null;

    // Mirror direction of item 4's guarantor-conflict override: this applicant showing up as a
    // guarantor on another active application. Same "unresolved" derivation as the guarantor-side
    // HasUnresolvedConflict in GuarantorsEditor.razor — a conflict list can stay non-empty even once
    // resolved (the other application is still active), so resolution is judged purely by whether an
    // override has been approved.
    private static bool HasUnresolvedApplicantConflict(ApplicationDto application) =>
        application.ApplicantGuarantorConflictApplicationNumbers.Count > 0 && application.ApplicantGuarantorConflictOverrideApprovedAt is null;

    private bool CanOverrideApplicantConflict => AuthState.HasPermission("applications.overrideguarantor");

    private bool ApproveBlockedByApplicantConflict =>
        _newStatus == "Approved" && _managing is not null && HasUnresolvedApplicantConflict(_managing);

    // Bonus consistency fix (2026-09 feedback item 4 back-fill): the existing guarantor-guarantor
    // conflict previously only surfaced as a server 422 with no client-side warning in this modal.
    // GuarantorsEditor owns the per-row conflict data internally, so it reports up whether ANY loaded
    // row currently has an unresolved conflict via OnConflictStateChanged (fired on load, after save,
    // and after an override is approved) — reset to false in OpenManageModalAsync so a stale value
    // from a previously-managed application never leaks in, most importantly for a non-ROZGAR
    // application where GuarantorsEditor isn't rendered at all to update it.
    private bool _hasUnresolvedGuarantorConflict;

    private bool ApproveBlockedByGuarantorConflict => _newStatus == "Approved" && _hasUnresolvedGuarantorConflict;

    // Fires when staff switch the dropdown to Approved. D9 (2026-09 client decision): the field must
    // start BLANK on a first-time approval — the requested amount is never a default, staff always
    // type the approved amount themselves. It only prefills when the application already has an
    // ApprovedAmount (the OnHold-re-approval case), which mirrors ChangeStatusAsync's own server-side
    // behavior of keeping the existing ApprovedAmount when none is newly supplied. The "Requested:
    // PKR X" hint (below) still shows the ask for reference while staff type.
    private void OnNewStatusChanged()
    {
        if (_newStatus == "Approved" && _managing is not null)
        {
            _approvedAmount = _managing.ApprovedAmount;
        }
    }

    // Mirrors ApplicationDto.GuarantorCount, kept live by GuarantorsEditor's OnCountChanged so the
    // "Guarantors (X/N)" tab title updates the moment staff save a row, not just on next reopen.
    private int _guarantorCount;

    // "Paid" only counts Completed payments — a Voided payment isn't real money paid, but it still
    // needs to be listed in the table below for audit visibility.
    private decimal PaymentsPaid => _payments.Where(p => p.Status == "Completed").Sum(p => p.Amount);
    private decimal? PaymentsRemaining => _managing?.ApprovedAmount is { } approved ? approved - PaymentsPaid : null;

    private List<(string Label, Func<Task> Clear)> ActiveFilters
    {
        get
        {
            var filters = new List<(string, Func<Task>)>();
            if (!string.IsNullOrEmpty(_statusFilter))
            {
                filters.Add(($"Status: {_statusFilter}", async () => { _statusFilter = ""; await LoadPageAsync(1); }));
            }
            if (!string.IsNullOrEmpty(_categoryFilter))
            {
                var name = _categories.FirstOrDefault(c => c.Id.ToString() == _categoryFilter)?.Name ?? _categoryFilter;
                filters.Add(($"Category: {name}", async () => { _categoryFilter = ""; await LoadPageAsync(1); }));
            }
            if (_dateFromFilter is not null)
            {
                filters.Add(($"From: {_dateFromFilter:yyyy-MM-dd}", async () => { _dateFromFilter = null; await LoadPageAsync(1); }));
            }
            if (_dateToFilter is not null)
            {
                filters.Add(($"To: {_dateToFilter:yyyy-MM-dd}", async () => { _dateToFilter = null; await LoadPageAsync(1); }));
            }
            if (!string.IsNullOrEmpty(_channelFilter))
            {
                filters.Add(($"Channel: {ChannelFilterLabel(_channelFilter)}", async () => { _channelFilter = ""; await LoadPageAsync(1); }));
            }
            return filters;
        }
    }

    private static string ChannelFilterLabel(string channel) => channel switch
    {
        "InApp" => "In-App",
        "GoogleForm" => "Google Form",
        _ => channel,
    };

    private async Task ClearAllFiltersAsync()
    {
        _statusFilter = "";
        _categoryFilter = "";
        _channelFilter = "";
        _dateFromFilter = null;
        _dateToFilter = null;
        await LoadPageAsync(1);
    }

    // "Show them" on the new-intake banner: sets filter state directly (rather than navigating via
    // URL) since the existing _lastApplied*Query guard in OnParametersSetAsync would otherwise skip
    // re-applying an identical query string. Surfaces through the page's existing removable
    // "Channel: Google Form" chip in ActiveFilters — no new filter-chip UI needed.
    private async Task ShowNewIntakeApplicationsAsync()
    {
        _channelFilter = "GoogleForm";
        _intakeBannerDismissed = true;
        await LoadPageAsync(1);
    }

    protected override async Task OnInitializedAsync()
    {
        _categories = await ApiClient.GetApplicationCategoriesAsync();
        _funds = await ApiClient.GetFundCategoriesAsync();
        await LoadPageAsync(1);

        // Marks Google Form intake as seen for this user — this also clears the sidebar badge
        // immediately (IntakeNotificationState raises Changed, MainLayout re-renders) rather than
        // waiting up to 60s for the next poll. Never throws; safe to await inline.
        var cleared = await IntakeState.MarkSeenAsync();
        if (cleared > 0 && string.IsNullOrWhiteSpace(IntakeChannelQuery))
        {
            _newIntakeBannerCount = cleared;
            _pendingIntakeBannerAnimation = true;
        }
    }

    // Deep-link from the Dashboard's "Needs Attention" list — GoToApplication navigates here with
    // ?applicationId={id}, and this opens that specific application's manage modal on load instead
    // of just landing on the unfiltered list (the fix for the dead-end links the client flagged).
    // Also handles the sidebar's Google Form badge/toast deep link (F3/F4):
    // "?status=Pending&intakeChannel=GoogleForm" — applied once per distinct incoming query value
    // (compared against what was last applied) so clicking the badge again while already on this
    // page re-applies the filter, but an unrelated re-render never clobbers a filter the user
    // changed by hand afterward.
    protected override async Task OnParametersSetAsync()
    {
        if (StatusQuery != _lastAppliedStatusQuery || IntakeChannelQuery != _lastAppliedIntakeChannelQuery)
        {
            _lastAppliedStatusQuery = StatusQuery;
            _lastAppliedIntakeChannelQuery = IntakeChannelQuery;
            if (!string.IsNullOrWhiteSpace(StatusQuery) || !string.IsNullOrWhiteSpace(IntakeChannelQuery))
            {
                _statusFilter = StatusQuery ?? "";
                _channelFilter = IntakeChannelQuery ?? "";
                await LoadPageAsync(1);
            }
        }

        if (ApplicationIdQuery is { } id && id != _autoOpenedApplicationId)
        {
            _autoOpenedApplicationId = id;
            try
            {
                var application = await ApiClient.GetApplicationAsync(id);
                await OpenManageModalAsync(application);
            }
            catch (ApiException)
            {
                // Stale/invalid id in the URL — nothing to open, fall through to the plain list.
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingRowAnimation)
        {
            _pendingRowAnimation = false;
            await JS.InvokeVoidAsync("ngoFundMotion.animateTableRows", "#applications-rows tr");
        }

        if (_pendingApplicantConflictAnimation)
        {
            _pendingApplicantConflictAnimation = false;
            await JS.InvokeVoidAsync("ngoFundMotion.animateWarningBanner", $"#{ApplicantConflictBannerId}");
        }

        if (_pendingIntakeBannerAnimation)
        {
            _pendingIntakeBannerAnimation = false;
            await JS.InvokeVoidAsync("ngoFundMotion.animateWarningBanner", $"#{IntakeBannerId}");
        }
    }

    private int _loadToken;

    private async Task LoadPageAsync(int page)
    {
        var token = ++_loadToken;
        _errorMessage = null;
        try
        {
            var result = await ApiClient.GetApplicationsAsync(page, PageSize,
                string.IsNullOrWhiteSpace(_search) ? null : _search,
                string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
                applicantId: null,
                categoryId: string.IsNullOrWhiteSpace(_categoryFilter) ? null : Guid.Parse(_categoryFilter),
                dateFrom: _dateFromFilter,
                dateTo: _dateToFilter,
                intakeChannel: string.IsNullOrWhiteSpace(_channelFilter) ? null : _channelFilter);
            if (token != _loadToken)
            {
                return; // a newer load superseded this one; discard
            }
            _page = result;
            _currentPage = page;
            _pendingRowAnimation = true;
        }
        catch (ApiException ex)
        {
            if (token != _loadToken)
            {
                return;
            }
            _errorMessage = ex.Message;
        }
    }

    private void OpenCreateWizard() => _showCreateWizard = true;

    private async Task CloseCreateWizardAsync()
    {
        // The wizard only ever fires OnClosed once the base application already exists server-side
        // (or nothing was ever created) — either way, closing just returns to the list.
        _showCreateWizard = false;
        await LoadPageAsync(_currentPage);
    }

    private async Task OpenManageModalAsync(ApplicationDto application)
    {
        _managing = application;
        _manageError = null;
        _newStatus = application.AllowedNextStatuses.FirstOrDefault() ?? "";
        _statusRemarks = "";
        _rejectionReason = "";
        _approvedAmount = application.ApprovedAmount;
        OnNewStatusChanged();
        _newRemark = "";
        _newRemarkIsInternal = false;
        _guarantorCount = application.GuarantorCount;
        _hasUnresolvedGuarantorConflict = false;
        _pendingApplicantConflictAnimation = HasUnresolvedApplicantConflict(application);
        _completeness = null;
        await ReloadManageDataAsync();
    }

    private void OpenApplicantConflictOverrideModal()
    {
        _applicantConflictOverrideReason = "";
        _showApplicantConflictOverrideModal = true;
    }

    private void CloseApplicantConflictOverrideModal() => _showApplicantConflictOverrideModal = false;

    private async Task ConfirmApplicantConflictOverrideAsync()
    {
        if (_managing is null || string.IsNullOrWhiteSpace(_applicantConflictOverrideReason))
        {
            return;
        }

        _isSavingApplicantConflictOverride = true;
        try
        {
            _managing = await ApiClient.ApproveApplicantGuarantorConflictOverrideAsync(_managing.Id, _applicantConflictOverrideReason);
            Toast.Success("Conflict override approved");
            _showApplicantConflictOverrideModal = false;
            await ReloadManageDataAsync();
        }
        catch (ApiException ex)
        {
            _manageError = ex.Message;
        }
        finally
        {
            _isSavingApplicantConflictOverride = false;
        }
    }

    private async Task ReloadManageDataAsync()
    {
        if (_managing is null)
        {
            return;
        }

        try
        {
            _history = await ApiClient.GetApplicationHistoryAsync(_managing.Id);
            _remarks = await ApiClient.GetApplicationRemarksAsync(_managing.Id);
            _documents = await ApiClient.GetDocumentsForApplicationAsync(_managing.Id);
            _payments = AuthState.HasPermission("payments.view")
                ? (await ApiClient.GetPaymentsAsync(1, 100, applicationId: _managing.Id)).Items
                : [];

            if (CategoryHasManifest)
            {
                _isCompletenessLoading = true;
                try
                {
                    _completeness = await ApiClient.GetApplicationCompletenessAsync(_managing.Id);
                }
                finally
                {
                    _isCompletenessLoading = false;
                }
            }
        }
        catch (ApiException ex)
        {
            _manageError = ex.Message;
        }
    }

    private void CloseManageModal()
    {
        _managing = null;

        // Drop the query-string id so navigating away and back (or reopening a different row)
        // doesn't try to re-open a modal that's already been closed.
        if (ApplicationIdQuery is not null)
        {
            Navigation.NavigateTo("/applications", replace: true);
        }
    }

    private async Task ChangeStatusAsync()
    {
        if (_managing is null || string.IsNullOrWhiteSpace(_newStatus))
        {
            return;
        }

        _isChangingStatus = true;
        _manageError = null;
        try
        {
            await ApiClient.ChangeApplicationStatusAsync(_managing.Id, _newStatus,
                string.IsNullOrWhiteSpace(_statusRemarks) ? null : _statusRemarks,
                string.IsNullOrWhiteSpace(_rejectionReason) ? null : _rejectionReason,
                _newStatus == "Approved" ? _approvedAmount : null);

            _managing = await ApiClient.GetApplicationAsync(_managing.Id);
            _guarantorCount = _managing.GuarantorCount;
            _newStatus = _managing.AllowedNextStatuses.FirstOrDefault() ?? "";
            _approvedAmount = _managing.ApprovedAmount;
            OnNewStatusChanged();
            Toast.Success($"Status updated · {_managing.ApplicationNumber}");
            await ReloadManageDataAsync();
            await LoadPageAsync(_currentPage);
        }
        catch (ApiException ex)
        {
            _manageError = ex.Message;
        }
        finally
        {
            _isChangingStatus = false;
        }
    }

    private async Task AddRemarkAsync()
    {
        if (_managing is null || string.IsNullOrWhiteSpace(_newRemark))
        {
            return;
        }

        try
        {
            await ApiClient.AddApplicationRemarkAsync(_managing.Id, _newRemark, _newRemarkIsInternal);
            _newRemark = "";
            _newRemarkIsInternal = false;
            await ReloadManageDataAsync();
        }
        catch (ApiException ex)
        {
            _manageError = ex.Message;
        }
    }

}

@page "/applications"
@inject ApiClient ApiClient
@inject AuthState AuthState
@inject ToastService Toast
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="page-header">
    @if (AuthState.HasPermission("applications.create"))
    {
        <SectionContent SectionName="page-actions">
            <button class="btn btn-primary" @onclick="OpenCreateWizard">New Application</button>
        </SectionContent>
    }
</div>

<FilterBar>
    <SearchBox @bind-Value="_search" OnSearch="() => LoadPageAsync(1)" Placeholder="Search by app #, membership #, name, CNIC…" />
    <div class="field filter-field-md mb-0">
        <label for="statusFilter">Status</label>
        <select id="statusFilter" @bind="_statusFilter" @bind:after="() => LoadPageAsync(1)">
            <option value="">All statuses</option>
            @foreach (var status in Statuses)
            {
                <option value="@status">@status</option>
            }
        </select>
    </div>
    <div class="field filter-field-lg mb-0">
        <label for="categoryFilter">Category</label>
        <select id="categoryFilter" @bind="_categoryFilter" @bind:after="() => LoadPageAsync(1)">
            <option value="">All categories</option>
            @foreach (var category in _categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>
    <div class="field filter-field-sm mb-0">
        <label for="dateFromFilter">From</label>
        <input id="dateFromFilter" type="date" @bind="_dateFromFilter" @bind:after="() => LoadPageAsync(1)" />
    </div>
    <div class="field filter-field-sm mb-0">
        <label for="dateToFilter">To</label>
        <input id="dateToFilter" type="date" @bind="_dateToFilter" @bind:after="() => LoadPageAsync(1)" />
    </div>
</FilterBar>

<FilterChips Filters="ActiveFilters" OnClearAll="ClearAllFiltersAsync" />

@if (_errorMessage is not null)
{
    <div class="alert alert-error">@_errorMessage</div>
}

<DataTable TItem="ApplicationDto" Items="_page?.Items ?? []" IsLoading="_page is null" ShowPagination="true"
           Page="_currentPage" PageSize="PageSize" TotalCount="_page?.TotalCount ?? 0"
           OnPageChange="LoadPageAsync" RowsContainerId="applications-rows" EmptyText="No applications found."
           EmptyDescription="Applications you record will appear here." EmptyIcon="applications">
    <HeaderRow>
        <th>App #</th>
        <th>Applicant</th>
        <th>Category</th>
        <th>Fund</th>
        <th class="num">Requested (PKR)</th>
        <th class="num">Approved (PKR)</th>
        <th>Priority</th>
        <th>Status</th>
        <th>Date</th>
        <th></th>
    </HeaderRow>
    <RowTemplate Context="application">
        <tr>
            <td>@application.ApplicationNumber</td>
            <td>@application.ApplicantName</td>
            <td>@application.ApplicationCategoryName</td>
            <td>@application.FundCategoryName</td>
            <td class="num">@application.RequestedAmount.ToString("N2")</td>
            <td class="num">@(application.ApprovedAmount?.ToString("N2") ?? "-")</td>
            <td>@application.Priority</td>
            <td><StatusBadge Status="@application.Status" /></td>
            <td>@application.ApplicationDate.ToString("yyyy-MM-dd")</td>
            <td class="table-actions">
                <button class="icon-btn" aria-label="Manage application" @onclick="() => OpenManageModalAsync(application)"><Icon Name="eye" Size="16" /></button>
            </td>
        </tr>
    </RowTemplate>
</DataTable>

@if (_showCreateWizard)
{
    <ApplicationWizard Categories="_categories" Funds="_funds" OnClosed="CloseCreateWizardAsync" />
}

@if (_managing is not null)
{
    <Modal Title="@($"{_managing.ApplicationNumber} — {_managing.ApplicantName}")" Size="lg" OnClose="CloseManageModal">
        <SubHeader>
            <div class="application-summary-header">
                <div class="application-summary-main">
                    <span class="application-summary-name">@_managing.ApplicantName</span>
                    <span class="application-summary-number">@_managing.ApplicationNumber</span>
                    <StatusBadge Status="@_managing.Status" />
                </div>
                <div class="application-summary-amounts">
                    <div>
                        <div class="fund-balance-col-label">Requested</div>
                        <div class="fund-balance-col-value">@_managing.RequestedAmount.ToString("N2")</div>
                    </div>
                    <div>
                        <div class="fund-balance-col-label">Approved</div>
                        <div class="fund-balance-col-value">@(_managing.ApprovedAmount?.ToString("N2") ?? "-")</div>
                    </div>
                    <div>
                        <div class="fund-balance-col-label">Remaining</div>
                        <div class="fund-balance-col-value">@(PaymentsRemaining?.ToString("N2") ?? "-")</div>
                    </div>
                </div>
            </div>
        </SubHeader>
        <ChildContent>
        @if (_manageError is not null)
        {
            <div class="alert alert-error">@_manageError</div>
        }

        <Tabs AriaLabel="Application details">
            <TabPanel Title="Details">
                <DetailList>
                    <DetailItem Label="Category" Value="@_managing.ApplicationCategoryName" />
                    <DetailItem Label="Fund" Value="@_managing.FundCategoryName" />
                    <DetailItem Label="Priority" Value="@_managing.Priority" />
                    <DetailItem Label="Intake Channel" Value="@_managing.IntakeChannel" />
                    <DetailItem Label="Purpose" Value="@_managing.Purpose" SpanFull="true" />
                </DetailList>

                @if (CategoryHasManifest)
                {
                    <FormSection Title="Completeness">
                        <CompletenessChecklist Completeness="_completeness" IsLoading="_isCompletenessLoading" />
                    </FormSection>
                }

                @if (_managing.ApplicationCategoryCode == "HOUSE_RENT")
                {
                    <HousingDetailsSection ApplicationId="_managing.Id" @key="_managing.Id" />
                }
                else if (_managing.ApplicationCategoryCode == "SHAADI")
                {
                    <MarriageDetailsSection ApplicationId="_managing.Id" @key="_managing.Id" />
                }
                else if (_managing.ApplicationCategoryCode == "ROZGAR")
                {
                    <BusinessLoanDetailsSection ApplicationId="_managing.Id" RequestedAmount="_managing.RequestedAmount" @key="_managing.Id" />
                }

                @if (AuthState.HasPermission("applications.review"))
                {
                    <FormSection Title="Change Status">
                        @if (_managing.AllowedNextStatuses.Count == 0)
                        {
                            <p class="field-hint">No further manual status changes are available right now.</p>
                        }
                        else
                        {
                            <div class="flex gap-3 items-end flex-wrap">
                                <div class="field w-200 mb-0">
                                    <label for="newStatus">New status</label>
                                    <select id="newStatus" @bind="_newStatus">
                                        @foreach (var status in _managing.AllowedNextStatuses)
                                        {
                                            <option value="@status">@status</option>
                                        }
                                    </select>
                                </div>
                                <div class="field flex-1 min-w-200 mb-0">
                                    <label for="statusRemarks">Remarks</label>
                                    <input id="statusRemarks" @bind="_statusRemarks" />
                                </div>
                                @if (_newStatus == "Rejected")
                                {
                                    <div class="field flex-1 min-w-200 mb-0">
                                        <label for="rejectionReason">Rejection reason</label>
                                        <input id="rejectionReason" @bind="_rejectionReason" />
                                    </div>
                                }
                                <button class="btn btn-primary" @onclick="ChangeStatusAsync" disabled="@(_isChangingStatus || ApproveBlockedByCompleteness)">Apply</button>
                            </div>
                            @if (ApproveBlockedByCompleteness)
                            {
                                <p class="field-error">This application is missing required information/documents — see Completeness above — and cannot be moved to Approved yet.</p>
                            }
                        }
                    </FormSection>
                }

                <FormSection Title="History">
                    @if (_history.Count == 0)
                    {
                        <EmptyState Icon="applications" Title="No history yet" Description="Status changes will appear here." />
                    }
                    else
                    {
                        <ul class="timeline">
                            @foreach (var entry in _history.OrderByDescending(h => h.ChangedAt))
                            {
                                <li class="timeline-item">
                                    <span class="timeline-marker"></span>
                                    <div class="timeline-content">
                                        <div class="timeline-transition">
                                            @(entry.FromStatus is null ? "Created as" : $"{entry.FromStatus} →")
                                            <StatusBadge Status="@entry.ToStatus" />
                                        </div>
                                        <div class="timeline-meta" title="@entry.ChangedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")">@RelativeTimeFormat.From(entry.ChangedAt)</div>
                                        @if (!string.IsNullOrEmpty(entry.Remarks))
                                        {
                                            <div class="timeline-remarks">@entry.Remarks</div>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </FormSection>

                <FormSection Title="Remarks">
                    @if (_remarks.Count == 0)
                    {
                        <EmptyState Icon="applications" Title="No remarks yet" />
                    }
                    else
                    {
                        <div>
                            @foreach (var remark in _remarks.OrderByDescending(r => r.CreatedAt))
                            {
                                <div class="remark-item">
                                    <div class="remark-header">
                                        <span title="@remark.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")">@RelativeTimeFormat.From(remark.CreatedAt)</span>
                                        @if (remark.IsInternal)
                                        {
                                            <span class="badge badge-internal">Internal</span>
                                        }
                                    </div>
                                    <div class="remark-body">@remark.Remark</div>
                                </div>
                            }
                        </div>
                    }
                    @if (AuthState.HasPermission("applications.edit"))
                    {
                        <div class="remark-composer">
                            <div class="field flex-1 mb-0">
                                <label for="newRemarkText">Add a remark</label>
                                <input id="newRemarkText" @bind="_newRemark" />
                            </div>
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="_newRemarkIsInternal" /> Internal
                            </label>
                            <button class="btn btn-secondary" @onclick="AddRemarkAsync">Add</button>
                        </div>
                    }
                </FormSection>
            </TabPanel>

            @if (_managing.ApplicationCategoryCode == "ROZGAR")
            {
                <TabPanel Title="@($"Guarantors ({_guarantorCount}/{_managing.RequiresGuarantors})")">
                    <GuarantorsEditor ApplicationId="_managing.Id" RequiredCount="_managing.RequiresGuarantors"
                                      OnCountChanged="c => _guarantorCount = c" @key="_managing.Id" />
                </TabPanel>
            }

            @if (AuthState.HasPermission("payments.view"))
            {
                <TabPanel Title="@($"Payments ({_payments.Count})")">
                    <FormSection Title="Payment History">
                        <div class="card payment-summary-card">
                            <div>
                                <div class="fund-balance-col-label">Approved</div>
                                <div class="fund-balance-col-value">@(_managing.ApprovedAmount?.ToString("N2") ?? "-")</div>
                            </div>
                            <div>
                                <div class="fund-balance-col-label">Paid</div>
                                <div class="fund-balance-col-value">@PaymentsPaid.ToString("N2")</div>
                            </div>
                            <div>
                                <div class="fund-balance-col-label">Remaining</div>
                                <div class="fund-balance-col-value">@(PaymentsRemaining?.ToString("N2") ?? "-")</div>
                            </div>
                        </div>

                        @if (_payments.Count == 0)
                        {
                            <EmptyState Icon="payments" Title="No payments recorded yet" />
                        }
                        else
                        {
                            <div class="table-wrapper">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Number</th>
                                            <th>Date</th>
                                            <th class="num">Amount (PKR)</th>
                                            <th>Method</th>
                                            <th>Status</th>
                                            <th>Void Reason</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var payment in _payments.OrderByDescending(p => p.PaymentDate))
                                        {
                                            <tr>
                                                <td>@payment.PaymentNumber</td>
                                                <td>@payment.PaymentDate.ToString("yyyy-MM-dd")</td>
                                                <td class="num">@payment.Amount.ToString("N2")</td>
                                                <td>@payment.PaymentMethod</td>
                                                <td><StatusBadge Status="@payment.Status" /></td>
                                                <td>@(payment.Status == "Voided" ? (payment.VoidReason ?? "-") : "-")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </FormSection>
                </TabPanel>
            }

            @if (_managing.RequiresLoanPlan || _managing.LoanAgreementId is not null)
            {
                @* RequiresLoanPlan alone flips false once an Active agreement exists (it gates
                   payments, not this panel) — see LoanSchedulePanel's IsGeneralFundApplication doc
                   comment for why both fields are checked here. Wrapping the TabPanel itself in
                   this same condition (not just LoanSchedulePanel's own internal check) is what
                   keeps the Installments tab out of the DOM entirely for Zakat-fund applications,
                   per Tabs.razor's dynamic-registration design. *@
                <TabPanel Title="Installments">
                    <LoanSchedulePanel ApplicationId="_managing.Id"
                                        IsGeneralFundApplication="_managing.RequiresLoanPlan || _managing.LoanAgreementId is not null"
                                        @key="_managing.Id" />
                </TabPanel>
            }

            <TabPanel Title="@($"Documents ({_documents.Count})")">
                <FormSection Title="Documents">
                    <DocumentSlotList ApplicationId="_managing.Id" ApplicantId="_managing.ApplicantId" Slots="_completeness?.Slots ?? []"
                                       ExtraDocuments="_documents.Where(d => d.SlotKey is null).ToList()"
                                       OnChanged="ReloadManageDataAsync" OnViewDocument="doc => _viewingDocument = doc" />
                </FormSection>
            </TabPanel>
        </Tabs>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseManageModal">Close</button>
        </Footer>
    </Modal>
}

<DocumentViewer Document="_viewingDocument" OnClose="() => _viewingDocument = null" />

@code {
    private static readonly string[] Statuses =
        ["Pending", "UnderReview", "Approved", "Rejected", "Paid", "PartiallyPaid", "OnHold"];

    [SupplyParameterFromQuery(Name = "applicationId")]
    [Parameter]
    public Guid? ApplicationIdQuery { get; set; }

    private const int PageSize = 25;
    private PagedResult<ApplicationDto>? _page;
    private int _currentPage = 1;
    private string _search = "";
    private string _statusFilter = "";
    private string _categoryFilter = "";
    private DateOnly? _dateFromFilter;
    private DateOnly? _dateToFilter;
    private string? _errorMessage;
    private bool _pendingRowAnimation;
    private Guid? _autoOpenedApplicationId;

    private IReadOnlyList<ApplicationCategoryDto> _categories = [];
    private IReadOnlyList<FundCategoryDto> _funds = [];

    private bool _showCreateWizard;

    private ApplicationDto? _managing;
    private string? _manageError;
    private IReadOnlyList<ApplicationStatusHistoryDto> _history = [];
    private IReadOnlyList<ApplicationRemarkDto> _remarks = [];
    private IReadOnlyList<DocumentDto> _documents = [];
    private IReadOnlyList<PaymentDto> _payments = [];
    private DocumentDto? _viewingDocument;
    private string _newStatus = "";
    private string _statusRemarks = "";
    private string _rejectionReason = "";
    private bool _isChangingStatus;
    private string _newRemark = "";
    private bool _newRemarkIsInternal;

    // Completeness backs both the manage modal's inline checklist and the Approve-gate below —
    // fetched alongside history/remarks/documents/payments in ReloadManageDataAsync so it's never
    // stale relative to what the user is looking at. Only HOUSE_RENT/SHAADI/ROZGAR carry a document
    // manifest — see CategoryHasManifest — everything else has nothing to check, matching how those
    // categories behaved before this milestone.
    private ApplicationCompletenessDto? _completeness;
    private bool _isCompletenessLoading;

    private bool CategoryHasManifest =>
        _managing?.ApplicationCategoryCode is "HOUSE_RENT" or "SHAADI" or "ROZGAR";

    // Client-side mirror of the server's Approved-transition completeness gate (already enforced
    // API-side as the backstop) — disables the Apply button and shows why inline, rather than
    // letting staff hit a 422 with no context after clicking.
    private bool ApproveBlockedByCompleteness =>
        _newStatus == "Approved" && CategoryHasManifest && _completeness is { IsComplete: false };

    // Mirrors ApplicationDto.GuarantorCount, kept live by GuarantorsEditor's OnCountChanged so the
    // "Guarantors (X/N)" tab title updates the moment staff save a row, not just on next reopen.
    private int _guarantorCount;

    // "Paid" only counts Completed payments — a Voided payment isn't real money paid, but it still
    // needs to be listed in the table below for audit visibility.
    private decimal PaymentsPaid => _payments.Where(p => p.Status == "Completed").Sum(p => p.Amount);
    private decimal? PaymentsRemaining => _managing?.ApprovedAmount is { } approved ? approved - PaymentsPaid : null;

    private List<(string Label, Func<Task> Clear)> ActiveFilters
    {
        get
        {
            var filters = new List<(string, Func<Task>)>();
            if (!string.IsNullOrEmpty(_statusFilter))
            {
                filters.Add(($"Status: {_statusFilter}", async () => { _statusFilter = ""; await LoadPageAsync(1); }));
            }
            if (!string.IsNullOrEmpty(_categoryFilter))
            {
                var name = _categories.FirstOrDefault(c => c.Id.ToString() == _categoryFilter)?.Name ?? _categoryFilter;
                filters.Add(($"Category: {name}", async () => { _categoryFilter = ""; await LoadPageAsync(1); }));
            }
            if (_dateFromFilter is not null)
            {
                filters.Add(($"From: {_dateFromFilter:yyyy-MM-dd}", async () => { _dateFromFilter = null; await LoadPageAsync(1); }));
            }
            if (_dateToFilter is not null)
            {
                filters.Add(($"To: {_dateToFilter:yyyy-MM-dd}", async () => { _dateToFilter = null; await LoadPageAsync(1); }));
            }
            return filters;
        }
    }

    private async Task ClearAllFiltersAsync()
    {
        _statusFilter = "";
        _categoryFilter = "";
        _dateFromFilter = null;
        _dateToFilter = null;
        await LoadPageAsync(1);
    }

    protected override async Task OnInitializedAsync()
    {
        _categories = await ApiClient.GetApplicationCategoriesAsync();
        _funds = await ApiClient.GetFundCategoriesAsync();
        await LoadPageAsync(1);
    }

    // Deep-link from the Dashboard's "Needs Attention" list — GoToApplication navigates here with
    // ?applicationId={id}, and this opens that specific application's manage modal on load instead
    // of just landing on the unfiltered list (the fix for the dead-end links the client flagged).
    protected override async Task OnParametersSetAsync()
    {
        if (ApplicationIdQuery is { } id && id != _autoOpenedApplicationId)
        {
            _autoOpenedApplicationId = id;
            try
            {
                var application = await ApiClient.GetApplicationAsync(id);
                await OpenManageModalAsync(application);
            }
            catch (ApiException)
            {
                // Stale/invalid id in the URL — nothing to open, fall through to the plain list.
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingRowAnimation)
        {
            _pendingRowAnimation = false;
            await JS.InvokeVoidAsync("ngoFundMotion.animateTableRows", "#applications-rows tr");
        }
    }

    private int _loadToken;

    private async Task LoadPageAsync(int page)
    {
        var token = ++_loadToken;
        _errorMessage = null;
        try
        {
            var result = await ApiClient.GetApplicationsAsync(page, PageSize,
                string.IsNullOrWhiteSpace(_search) ? null : _search,
                string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
                applicantId: null,
                categoryId: string.IsNullOrWhiteSpace(_categoryFilter) ? null : Guid.Parse(_categoryFilter),
                dateFrom: _dateFromFilter,
                dateTo: _dateToFilter);
            if (token != _loadToken)
            {
                return; // a newer load superseded this one; discard
            }
            _page = result;
            _currentPage = page;
            _pendingRowAnimation = true;
        }
        catch (ApiException ex)
        {
            if (token != _loadToken)
            {
                return;
            }
            _errorMessage = ex.Message;
        }
    }

    private void OpenCreateWizard() => _showCreateWizard = true;

    private async Task CloseCreateWizardAsync()
    {
        // The wizard only ever fires OnClosed once the base application already exists server-side
        // (or nothing was ever created) — either way, closing just returns to the list.
        _showCreateWizard = false;
        await LoadPageAsync(_currentPage);
    }

    private async Task OpenManageModalAsync(ApplicationDto application)
    {
        _managing = application;
        _manageError = null;
        _newStatus = application.AllowedNextStatuses.FirstOrDefault() ?? "";
        _statusRemarks = "";
        _rejectionReason = "";
        _newRemark = "";
        _newRemarkIsInternal = false;
        _guarantorCount = application.GuarantorCount;
        _completeness = null;
        await ReloadManageDataAsync();
    }

    private async Task ReloadManageDataAsync()
    {
        if (_managing is null)
        {
            return;
        }

        try
        {
            _history = await ApiClient.GetApplicationHistoryAsync(_managing.Id);
            _remarks = await ApiClient.GetApplicationRemarksAsync(_managing.Id);
            _documents = await ApiClient.GetDocumentsForApplicationAsync(_managing.Id);
            _payments = AuthState.HasPermission("payments.view")
                ? (await ApiClient.GetPaymentsAsync(1, 100, applicationId: _managing.Id)).Items
                : [];

            if (CategoryHasManifest)
            {
                _isCompletenessLoading = true;
                try
                {
                    _completeness = await ApiClient.GetApplicationCompletenessAsync(_managing.Id);
                }
                finally
                {
                    _isCompletenessLoading = false;
                }
            }
        }
        catch (ApiException ex)
        {
            _manageError = ex.Message;
        }
    }

    private void CloseManageModal()
    {
        _managing = null;

        // Drop the query-string id so navigating away and back (or reopening a different row)
        // doesn't try to re-open a modal that's already been closed.
        if (ApplicationIdQuery is not null)
        {
            Navigation.NavigateTo("/applications", replace: true);
        }
    }

    private async Task ChangeStatusAsync()
    {
        if (_managing is null || string.IsNullOrWhiteSpace(_newStatus))
        {
            return;
        }

        _isChangingStatus = true;
        _manageError = null;
        try
        {
            await ApiClient.ChangeApplicationStatusAsync(_managing.Id, _newStatus,
                string.IsNullOrWhiteSpace(_statusRemarks) ? null : _statusRemarks,
                string.IsNullOrWhiteSpace(_rejectionReason) ? null : _rejectionReason);

            _managing = await ApiClient.GetApplicationAsync(_managing.Id);
            _guarantorCount = _managing.GuarantorCount;
            _newStatus = _managing.AllowedNextStatuses.FirstOrDefault() ?? "";
            Toast.Success($"Status updated · {_managing.ApplicationNumber}");
            await ReloadManageDataAsync();
            await LoadPageAsync(_currentPage);
        }
        catch (ApiException ex)
        {
            _manageError = ex.Message;
        }
        finally
        {
            _isChangingStatus = false;
        }
    }

    private async Task AddRemarkAsync()
    {
        if (_managing is null || string.IsNullOrWhiteSpace(_newRemark))
        {
            return;
        }

        try
        {
            await ApiClient.AddApplicationRemarkAsync(_managing.Id, _newRemark, _newRemarkIsInternal);
            _newRemark = "";
            _newRemarkIsInternal = false;
            await ReloadManageDataAsync();
        }
        catch (ApiException ex)
        {
            _manageError = ex.Message;
        }
    }

}

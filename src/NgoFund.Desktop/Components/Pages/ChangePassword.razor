@page "/change-password"
@layout AuthLayout
@inject ApiClient ApiClient
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="auth-layout">
    <div class="card auth-card" id="change-password-card">
        <div class="auth-brand-mark">NGO Fund Management</div>
        <h1>Change Password</h1>
        <p class="subtitle">
            @if (AuthState.CurrentUser?.MustChangePassword == true)
            {
                <text>You must set a new password before continuing.</text>
            }
            else
            {
                <text>Update your account password.</text>
            }
        </p>

        @if (_errorMessage is not null)
        {
            <div class="alert alert-error">@_errorMessage</div>
        }

        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <FormField Label="Current Password" For="current" ValidationFor="() => _model.CurrentPassword">
                <InputText id="current" type="password" @bind-Value="_model.CurrentPassword" autocomplete="current-password" />
            </FormField>

            <FormField Label="New Password" For="new" Hint="At least 8 characters." ValidationFor="() => _model.NewPassword">
                <InputText id="new" type="password" @bind-Value="_model.NewPassword" autocomplete="new-password" />
            </FormField>

            <FormField Label="Confirm New Password" For="confirm" ValidationFor="() => _model.ConfirmPassword">
                <InputText id="confirm" type="password" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" />
            </FormField>

            <button type="submit" class="btn btn-primary btn-block" disabled="@_isSubmitting">
                @(_isSubmitting ? "Saving..." : "Change Password")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private readonly ChangePasswordModel _model = new();
    private bool _isSubmitting;
    private string? _errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("ngoFundMotion.animateAuthCard", "#change-password-card");
        }
    }

    private async Task SubmitAsync()
    {
        _errorMessage = null;

        if (_model.NewPassword != _model.ConfirmPassword)
        {
            _errorMessage = "New password and confirmation do not match.";
            return;
        }

        _isSubmitting = true;
        try
        {
            await ApiClient.ChangePasswordAsync(_model.CurrentPassword, _model.NewPassword);
            Navigation.NavigateTo("/", replace: true);
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private class ChangePasswordModel
    {
        [Required] public string CurrentPassword { get; set; } = "";
        [Required, MinLength(8)] public string NewPassword { get; set; } = "";
        [Required] public string ConfirmPassword { get; set; } = "";
    }
}

@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState AuthState
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<MainLayout> Logger
@inject ToastService Toast
@inject IntakeNotificationState IntakeState

<div class="app-shell">
    <nav class="sidebar @(_sidebarCollapsed ? "collapsed" : "")" id="sidebar-nav">
        <div class="sidebar-header">
            <div class="sidebar-brand" title="NGO Fund Management">
                <img src="images/logo-icon.png" alt="NGO Fund Management" class="sidebar-brand-icon" />
                <img src="images/logo-full.png" alt="NGO Fund Management" class="sidebar-brand-logo" />
            </div>
            <button type="button" class="sidebar-toggle" id="sidebar-toggle-btn" @onclick="ToggleSidebarAsync"
                    aria-expanded="@(!_sidebarCollapsed)" aria-controls="sidebar-nav"
                    aria-label="@(_sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                    title="@(_sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")">
                <Icon Name="chevron-down" Size="16" CssClass="sidebar-toggle-icon" />
            </button>
        </div>

        <div class="nav-group-label">Overview</div>
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All" title="Dashboard"><Icon Name="dashboard" CssClass="nav-icon" /><span class="nav-label">Dashboard</span></NavLink>

        @if (AuthState.HasPermission("fundcategories.view") || AuthState.HasPermission("donors.view") || AuthState.HasPermission("donations.view"))
        {
            <div class="nav-group-label">Fundraising</div>
            @if (AuthState.HasPermission("fundcategories.view"))
            {
                <NavLink class="nav-item" href="funds" title="Funds"><Icon Name="funds" CssClass="nav-icon" /><span class="nav-label">Funds</span></NavLink>
            }
            @if (AuthState.HasPermission("donors.view"))
            {
                <NavLink class="nav-item" href="donors" title="Donors"><Icon Name="donors" CssClass="nav-icon" /><span class="nav-label">Donors</span></NavLink>
            }
            @if (AuthState.HasPermission("donations.view"))
            {
                <NavLink class="nav-item" href="donations" title="Donations"><Icon Name="donations" CssClass="nav-icon" /><span class="nav-label">Donations</span></NavLink>
            }
        }

        @if (AuthState.HasPermission("applicants.view") || AuthState.HasPermission("applications.view") || AuthState.HasPermission("payments.view") || AuthState.HasPermission("loans.view"))
        {
            <div class="nav-group-label">Assistance</div>
            @if (AuthState.HasPermission("applicants.view"))
            {
                <NavLink class="nav-item" href="applicants" title="Applicants"><Icon Name="applicants" CssClass="nav-icon" /><span class="nav-label">Applicants</span></NavLink>
            }
            @if (AuthState.HasPermission("applications.view"))
            {
                <NavLink class="nav-item" href="applications" title="Applications">
                    <Icon Name="applications" CssClass="nav-icon" /><span class="nav-label">Applications</span>
                    @if (IntakeState.UnreadCount > 0)
                    {
                        <span class="nav-count" id="@NavBadgeId" role="status" aria-atomic="true"
                              aria-label="@($"{IntakeState.UnreadCount} new Google Form application{(IntakeState.UnreadCount == 1 ? "" : "s")}")">
                            @IntakeState.UnreadCount
                        </span>
                    }
                </NavLink>
            }
            @if (AuthState.HasPermission("payments.view"))
            {
                <NavLink class="nav-item" href="payments" title="Payments"><Icon Name="payments" CssClass="nav-icon" /><span class="nav-label">Payments</span></NavLink>
            }
            @if (AuthState.HasPermission("loans.view"))
            {
                <NavLink class="nav-item" href="loans" title="Loans"><Icon Name="payments" CssClass="nav-icon" /><span class="nav-label">Loans</span></NavLink>
            }
        }

        @if (AuthState.HasPermission("users.view") || AuthState.HasPermission("auditlogs.view"))
        {
            <div class="nav-group-label">Administration</div>
            @if (AuthState.HasPermission("users.view"))
            {
                <NavLink class="nav-item" href="users" title="Users"><Icon Name="users" CssClass="nav-icon" /><span class="nav-label">Users</span></NavLink>
            }
            @if (AuthState.HasPermission("auditlogs.view"))
            {
                <NavLink class="nav-item" href="audit-logs" title="Activity Log"><Icon Name="audit" CssClass="nav-icon" /><span class="nav-label">Activity Log</span></NavLink>
            }
        }
    </nav>

    <div class="main-content">
        <header class="topbar">
            <h1 class="topbar-title">@CurrentPageTitle</h1>
            <div class="topbar-actions">
                <SectionOutlet SectionName="page-actions" />
            </div>
            <div class="user-menu">
                <span class="user-avatar">@UserInitial</span>
                <span>@AuthState.CurrentUser?.FullName</span>
                <button class="btn btn-secondary" @onclick="LogoutAsync"><Icon Name="logout" Size="16" />Log out</button>
            </div>
        </header>
        <main class="page-content" id="page-content-root">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="exception">
                    @{ LogPageError(exception); }
                    <div class="card" style="padding: var(--space-5); max-width: 640px;">
                        <h3>Something went wrong on this page</h3>
                        <p class="field-hint">@exception.Message</p>
                        <button class="btn btn-primary" @onclick="RecoverFromError">Try again</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
    <Toast />
</div>

@code {
    private static readonly Dictionary<string, string> PageTitles = new()
    {
        [""] = "Dashboard",
        ["funds"] = "Funds",
        ["donors"] = "Donors",
        ["donations"] = "Donations",
        ["applicants"] = "Applicants",
        ["applications"] = "Applications",
        ["payments"] = "Payments",
        ["loans"] = "Loans",
        ["users"] = "Users",
        ["audit-logs"] = "Activity Log",
        ["settings"] = "Settings",
    };

    private const string SidebarCollapsedKey = "ngofund.sidebar.collapsed";

    private ErrorBoundary? _errorBoundary;
    private bool _sidebarCollapsed;

    // F4 (redesign): sidebar "Applications" nav-count badge is now a true per-user "unread since I
    // last visited" count, served by IntakeNotificationState.UnreadCount (backed by the server-side
    // intake-seen watermark — see IntakeSummaryDto/IntakeSeenDto). The badge no longer tracks the
    // live Pending-status queue and no longer hijacks the nav item's destination: "Applications"
    // always opens the plain unfiltered list (GoogleFormFilterPath below is only ever used for the
    // toast's explicit deep link). A 60s poll refreshes the count; MainLayout additionally reacts to
    // IntakeNotificationState.Changed so a "seen" call from Applications.razor clears the badge
    // immediately instead of waiting for the next tick.
    private const int IntakePollIntervalSeconds = 60;
    private const string GoogleFormFilterPath = "applications?intakeChannel=GoogleForm";
    private const string NavBadgeId = "applications-nav-badge";

    private System.Threading.Timer? _intakePollTimer;
    private bool _pendingBadgePulse;

    // Toast-on-genuine-arrival baseline (redesign): no toast fires for whatever is already unread on
    // cold launch — the badge alone communicates that. A toast only fires when UnreadCount rises
    // above the baseline recorded the first time HasLoaded becomes true during this running session.
    private bool _hasUnreadBaseline;
    private int _unreadBaseline;

    private string UserInitial => string.IsNullOrEmpty(AuthState.CurrentUser?.FullName) ? "?" : AuthState.CurrentUser.FullName[..1].ToUpperInvariant();

    private string CurrentPageTitle
    {
        get
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.Trim('/');
            if (PageTitles.TryGetValue(path, out var title))
            {
                return title;
            }

            // Only parameterized route in the app right now (/applicants/{id}/ledger) — a
            // one-off suffix check rather than a general route-title framework for a single case.
            return path.StartsWith("applicants/", StringComparison.Ordinal) && path.EndsWith("/ledger", StringComparison.Ordinal)
                ? "Applicant Ledger"
                : "NgoFund";
        }
    }

    protected override void OnInitialized()
    {
        AuthState.Changed += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
        IntakeState.Changed += OnIntakeStateChanged;
        EnforceAuthGate();

        // Immediate first tick (dueTime: Zero), then every IntakePollIntervalSeconds.
        // IntakeNotificationState.RefreshAsync() itself checks IsAuthenticated/HasPermission and
        // never throws, so this can start unconditionally here without duplicating that gate.
        _intakePollTimer = new System.Threading.Timer(
            OnIntakePollTimerTick, null, TimeSpan.Zero, TimeSpan.FromSeconds(IntakePollIntervalSeconds));
    }

    // Timer callbacks run on a thread-pool thread, never the Blazor render sync context — the
    // refresh (and everything it triggers via IntakeState.Changed) happens inside InvokeAsync so
    // it's safe to mutate state and trigger a render.
    private async void OnIntakePollTimerTick(object? state)
    {
        await InvokeAsync(() => IntakeState.RefreshAsync());
    }

    // IntakeNotificationState.Changed may fire off the UI thread (HTTP completions, AuthState
    // changes) — wrap handling in InvokeAsync. This is also where the toast-on-genuine-arrival rule
    // lives (see _hasUnreadBaseline/_unreadBaseline doc comment above):
    //  - not loaded yet → ignore entirely.
    //  - no baseline yet (first load this session) → record it silently, no toast even if already > 0.
    //  - unread rose above the baseline → toast for the delta + badge pulse, then move the baseline up.
    //  - otherwise (unchanged or cleared, e.g. after a "seen" call) → just move the baseline, no toast.
    private async void OnIntakeStateChanged()
    {
        await InvokeAsync(() =>
        {
            if (!IntakeState.HasLoaded)
            {
                return;
            }

            if (!_hasUnreadBaseline)
            {
                _hasUnreadBaseline = true;
                _unreadBaseline = IntakeState.UnreadCount;
            }
            else if (IntakeState.UnreadCount > _unreadBaseline)
            {
                var delta = IntakeState.UnreadCount - _unreadBaseline;
                Toast.Info(
                    $"{delta} new Google Form application{(delta == 1 ? "" : "s")} received",
                    OnIntakeToastClicked);
                _pendingBadgePulse = true;
                _unreadBaseline = IntakeState.UnreadCount;
            }
            else
            {
                _unreadBaseline = IntakeState.UnreadCount;
            }

            StateHasChanged();
        });
    }

    private void OnIntakeToastClicked()
    {
        _ = IntakeState.MarkSeenAsync();
        Navigation.NavigateTo(GoogleFormFilterPath);
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        try
        {
            await JS.InvokeVoidAsync("ngoFundMotion.animatePageContent", "#page-content-root");
        }
        catch (JSDisconnectedException)
        {
            // Navigating during app shutdown — nothing to animate.
        }
    }

    private void LogPageError(Exception exception) => Logger.LogError(exception, "Unhandled exception rendering page content");

    private void RecoverFromError() => _errorBoundary?.Recover();

    protected override void OnParametersSet() => EnforceAuthGate();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var stored = await JS.InvokeAsync<string?>("ngoFundPrefs.get", SidebarCollapsedKey);
            if (stored == "true")
            {
                _sidebarCollapsed = true;
                StateHasChanged();
            }

            await JS.InvokeVoidAsync("ngoFundMotion.animateSidebarToggle", "#sidebar-toggle-btn .sidebar-toggle-icon", _sidebarCollapsed, true);
            await JS.InvokeVoidAsync("ngoFundMotion.animateSidebarNav", "#sidebar-nav .nav-item");
        }

        if (_pendingBadgePulse)
        {
            _pendingBadgePulse = false;
            await JS.InvokeVoidAsync("ngoFundMotion.pulseNavBadge", $"#{NavBadgeId}");
        }
    }

    private async Task ToggleSidebarAsync()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        await JS.InvokeVoidAsync("ngoFundPrefs.set", SidebarCollapsedKey, _sidebarCollapsed ? "true" : "false");
        await JS.InvokeVoidAsync("ngoFundMotion.animateSidebarToggle", "#sidebar-toggle-btn .sidebar-toggle-icon", _sidebarCollapsed, false);
    }

    private void EnforceAuthGate()
    {
        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        if (AuthState.CurrentUser!.MustChangePassword)
        {
            Navigation.NavigateTo("/change-password", replace: true);
        }
    }

    private async Task LogoutAsync()
    {
        await ApiClient.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    public void Dispose()
    {
        AuthState.Changed -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        IntakeState.Changed -= OnIntakeStateChanged;
        _intakePollTimer?.Dispose();
    }
}
